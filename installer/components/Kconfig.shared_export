# One capability a sharing unit takes from the owner it picked (shared_components.py).
#
# Sourced inside the consumer's `if <shared flag>` block, once per exported symbol, after
# Kconfig.shared_choice. The caller sets, immediately before each source:
#
#   shared_kind    key in shared_components.KINDS, e.g. buffer
#   shared_export  the symbol, e.g. MMU_HAS_SENSOR_BUFFER_COMPRESSION
#
# The last default keeps the value this unit saved when there is nothing to read: the owner
# isn't configured yet, the saved owner is unresolved, or the parse isn't a unit parse run
# by install.sh (no KCONFIG_PARENT).

config $(shared_export)
  @repeat var=i min=1 max=$(shared_slots)@
  default $(shared-export,$(shared_kind),$(i),$(shared_export)) if $(shared-member,$(shared_kind),$(i)) && $(shared-owner,$(shared_kind),$(i))
  @endrepeat@
  default $(first-nonempty,$(saved-config-value,$(shared_export)),n)
