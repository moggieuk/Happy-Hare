# TMC stepper driver - chip, bus and wiring prompts.
#
# Companion to Kconfig.tmc_driver_types, which declares the symbols, and to
# Kconfig.tmc_driver_menu_current, which prompts for the currents. They are
# separate because a consumer may place them in different menus: the
# Blobifier shows both together, while the gear and selector steppers keep
# their currents in their own stepper menu alongside gear ratio and
# microsteps.
#
# The caller sets, immediately before sourcing this:
#
#   prefix     name infix, matching the one used for the types fragment
#   label      prompt text stem, e.g. Stepper -> "Stepper TMC chip"
#   pad_width  column the prompts are padded to, for menu alignment
#
# $(pad,...) rather than literal trailing spaces, because the stem length
# varies with the label and hand-padding each instance would drift.

choice CHOICE_$(prefix)_TMC
  prompt "$(pad,$(pad_width),$(label) TMC chip)"
  default CHOICE_$(prefix)_TMC2209
  help
    Select correct TMC chip type for this stepper. The bus (UART or SPI)
    is fixed by the chip, except on the TMC2240 which can do either.

  config CHOICE_$(prefix)_TMC2209
    bool "TMC2209"
  config CHOICE_$(prefix)_TMC2226
    bool "TMC2226"
  config CHOICE_$(prefix)_TMC2208
    bool "TMC2208"
  config CHOICE_$(prefix)_TMC2130
    bool "TMC2130"
  config CHOICE_$(prefix)_TMC2660
    bool "TMC2660"
  config CHOICE_$(prefix)_TMC5160
    bool "TMC5160"
  config CHOICE_$(prefix)_TMC2240
    bool "TMC2240"
  config CHOICE_$(prefix)_TMC_NONE
    bool "None / hardware controlled"
endchoice

choice CHOICE_$(prefix)_TMC_BUS
  prompt "$(pad,$(pad_width),$(label) TMC bus)" if PARAM_$(prefix)_TMC != ""
  default CHOICE_$(prefix)_TMC_BUS_SPI
  help
    Only the TMC2240 offers a choice here. Most TMC2240 step sticks
    ship wired for SPI and need a jumper or solder bridge moved to
    use UART, so SPI is the default.

  config CHOICE_$(prefix)_TMC_BUS_UART
    bool "UART"
    depends on BOOL_$(prefix)_TMC_CAN_UART
  config CHOICE_$(prefix)_TMC_BUS_SPI
    bool "SPI"
    depends on BOOL_$(prefix)_TMC_CAN_SPI
endchoice

config PIN_$(prefix)_UART
  prompt "$(pad,$(pad_width),$(label) TMC UART pin)" if PARAM_$(prefix)_TMC != "" && !BOOL_$(prefix)_TMC_SPI
config PIN_$(prefix)_CS
  prompt "$(pad,$(pad_width),$(label) TMC CS pin)" if BOOL_$(prefix)_TMC_SPI
config PARAM_$(prefix)_SPI_BUS
  prompt "$(pad,$(pad_width),$(label) TMC SPI bus)" if BOOL_$(prefix)_TMC_SPI && !BOOL_$(prefix)_TMC_SPI_SOFTWARE
  help
    Hardware SPI bus name on the MCU owning the CS pin, e.g. spi2.
    Leave blank to use Klipper's default bus for that MCU.
config PIN_$(prefix)_SPI_SCLK
  prompt "$(pad,$(pad_width),$(label) TMC SPI SCLK pin)" if BOOL_$(prefix)_TMC_SPI
  help
    Leave all three SPI pins blank to use hardware SPI. To use software
    SPI, fill in all three pins. An incomplete set is an error.
    Prefix each pin with its MCU name; all three must be on the same
    MCU as the CS pin, e.g. mcu:PG8.
config PIN_$(prefix)_SPI_MOSI
  prompt "$(pad,$(pad_width),$(label) TMC SPI MOSI pin)" if BOOL_$(prefix)_TMC_SPI
config PIN_$(prefix)_SPI_MISO
  prompt "$(pad,$(pad_width),$(label) TMC SPI MISO pin)" if BOOL_$(prefix)_TMC_SPI
