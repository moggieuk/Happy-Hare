# IMPORTANT: Happy Hare TOKEN naming convention and kconfig features:
#   PARAM_*                Symbols of various types used in template rendering
#   PIN_*                  Used for string symbols representing pins
#   BOOL_*                 Boolean symbols often used to set prompt-less int PARAMS
#   MMU_HAS_*              Used for MMU hardware components like encoder
#   CHOICE_X, CHOICE_X_*   Named choice "X" or boolean selection config
#   UNSELECT_*             Special boolean symbol used to implement forced "unselect"
#
# The above list is special in that default values will be stored in the .mmu_config but will not
# force setting on subsequent runs. They therefore remain as modifiable defaults until user explicitly
# changes them. Also when they are changed from default values menuconfig will mark as
# "(NOT DEFAULT)" and allow the "r" keystroke to reset back to default value
#   
# Other names are stored and handled as normal Kconfig variables. Unlike the special names
# above, their saved values are always loaded as explicit assignments.
#
# Some Happy Hare augmented features:
# Kconfig:
# 1. Dynamic defaults 'generated_default'
#
#   Syntax:
#     generated_default "<template>" "<args>" [<separator>] [[<start>] <stop>]
#
#   <args> is a space-separated list of Kconfig symbols. Inside <template>:
#     %s, %d    - next arg from <args>, filled in left-to-right wherever it appears
#                 (list a symbol twice in <args> to fill two placeholders with it)
#     %i        - the current iterator value (only valid when <start>/<stop> given)
#     %%        - a literal '%'
#     {...}     - a basic arithmetic expression (+ - * / // % ** and parens),
#                 evaluated AFTER %s/%d/%i substitution -- reference them by
#                 writing the token inside the braces, e.g. "{%i % %d}"
#   Without <start>/<stop>, the template is rendered once. With them, it's
#   rendered once per value in range(start, stop) (start defaults to 0) and
#   the results joined with <separator> (defaults to ", ").
#
# Examples:
#   generated_default "%s_%d" "PARAM_ONE PARAM_TWO"
#   generated_default "%i_%s" "PARAM_ONE" PARAM_STOP
#   generated_default "%s_%i" "PARAM_VENDOR PARAM_VERSION" PARAM_START PARAM_STOP
#   generated_default "neopixel:$(UNIT_NAME)_gate%i_leds (1-%d)" "PARAM_NUM_GATES" PARAM_NUM_GATES
#   generated_default "{(%i + 1) % %d}" "PARAM_NUM_GATES" ", " 0 PARAM_NUM_GATES
#
# 2. Added float type
# 3. Option 'forceshow' to force symbols or menus to display even if their dependency isn't met
# 4. Recording of default value with #~DEFAULT~# magic token
# 5. Preprocessor function 'saved-config-value' to read a symbol's previous assignment from
#    KCONFIG_CONFIG before normal config loading, including lines marked with #~DEFAULT~#
# 6. repeat expansion macro to avoid multiple lines (can be nested):
#      @repeat var=i min=0 max=3@
#        config PARAM_MMU_CANBUS_UNIT_$(i)
#          string "CANbus UUID for MMU unit $(i)"
#      @endrepeat@
# 7. help added to menus
# 8. "if XX" construct is allowed on comment lines
# 9. Added 'array_editor <separator> [size]' option for strings that represent lists
#    E.g. `array_editor ";" PARAM_NUM_GATES
# 10. Added 'boolint' and 'defboolint' types: Boolean UI/logic with numeric 0/1 output
# 11. Font manipulators like [[B]]xx[[/B] can be used in prompts and comments
#    and include: B,BOLD,DIM,U,UNDERLINE,REV,REVERSE,C:n,COLOR:n (color), RESET
#
# Menuconfig:
# 1. 'r' to reset value to default
# 2. Flexible comment lines and section separator using "_" and "_comment"
# 3. Lots of formatting changes and style options
# 4. Variable input dialogs with better parsing
# 5. Added array editor - used on "," or ";" separated strings
#
#
# Capability params:
#   MMU_HAS_BUFFER_MCU
#   MMU_HAS_EJECT_BUTTONS
#   MMU_HAS_ENCODER
#   MMU_HAS_ENVIRONMENT_SENSOR
#   MMU_HAS_ESPOOLER
#   MMU_HAS_FILAMENT_BUFFER
#   MMU_HAS_HEATER
#   MMU_HAS_LEDS
#   MMU_HAS_PER_GATE_MCU (currently only EMU design)
#   MMU_HAS_PER_GATE_ENV_SENSORS
#   MMU_HAS_PER_GATE_HEATERS
#   MMU_HAS_SELECTOR
#   MMU_HAS_SELECTOR_SERVO
#   MMU_HAS_SELECTOR_STEPPER
#   MMU_HAS_SENSOR_ENTRY
#   MMU_HAS_SENSOR_EXIT
#   MMU_HAS_SENSOR_GEAR_TOUCH
#   MMU_HAS_SENSOR_SHARED_EXIT
#   MMU_HAS_SYNC_FEEDBACK_BUFFER
#     MMU_HAS_SENSOR_BUFFER_COMPRESSION
#     MMU_HAS_SENSOR_BUFFER_PROPORTIONAL
#     MMU_HAS_SENSOR_BUFFER_TENSION
#
# These will only be in shared config on multi-unit because they are on printer and not per-unit
#   MMU_HAS_SENSOR_EXTRUDER
#   MMU_HAS_SENSOR_TOOLHEAD
#   MMU_HAS_TOOLHEAD_CUTTER
#   MMU_HAS_SERVO_CUTTER
#   MMU_HAS_GANTRY_BUMPER_SERVO
#   MMU_HAS_BLOBIFIER


# IMPORTANT keep version string up-to-date and consistent with git tag
happy_hare_version := $(HH_VERSION)

hh_message  := $(shell, echo "Happy Hare v$(happy_hare_version)")
unit_suffix := $(shell, [ -n "$$UNIT_NAME" ] && echo "Unit: [[B]]$(UNIT_NAME)[[/B]]" || echo "")
title       := $(shell, [ "$F_MULTI_UNIT_ENTRY_POINT" = "y" ] && echo "$(hh_message) Configuration for [[B]]Multi Unit Setup[[/B]]" || echo "$(hh_message) Configuration - $(unit_suffix)")
caption     := $(shell, [ "$F_MULTI_UNIT_ENTRY_POINT" = "y" ] && echo "$(hh_message) - [[B]]Shared Config[[/B]]" || echo "Configuration - $(unit_suffix)")
caption_pad := $(shell, [ "$F_MULTI_UNIT_ENTRY_POINT" = "y" ] && echo "61" || echo "61")

# Expose these capability params to each unit
mmu_has_sensor_toolhead := $(shell, [ "$HAS_SENSOR_TOOLHEAD" = "y" ] && echo "y" || echo "n")
mmu_has_sensor_extruder := $(shell, [ "$HAS_SENSOR_EXTRUDER" = "y" ] && echo "y" || echo "n")
mmu_has_toolhead_cutter := $(shell, [ "$HAS_TOOLHEAD_CUTTER" = "y" ] && echo "y" || echo "n")

# Used to convert a shell command result to a y/n value
to_bool = $(shell, $(1) && echo y || echo n)

# Used to count arguments
count   = $(shell, set -- $(1); echo $#)

# Used to dynamically get the serial device paths
all_serial_devices  := $(shell, ls /dev/serial/by-id/* 2>/dev/null || true)
serial_device        = $(shell, printf '%s\n' $(all_serial_devices) | grep 'Klipper_$(2)' | sed -n '$(1)p')

serial_exists        = $(to_bool, [ -n '$(serial_device,$(1),$(2))' ])
mmu_serial_config    = $(shell, basename '$(serial_device,$(1),$(2))' | sed 's/-/_/g' | awk 'BEGIN{out="CHOICE_MMU_SERIAL_DEVICE_NONE" } NF && $$0!="." {out="CHOICE_MMU_SERIAL_DEVICE_" toupper($$0)} END{print out}')
mmu_serial_config_pg = $(shell, basename '$(serial_device,$(2),$(3))' | sed 's/-/_/g' | awk -v gate=$(1) 'BEGIN{out="CHOICE_MMU_SERIAL_DEVICE_NONE_GATE_" gate } NF && $$0!="." {out="CHOICE_MMU_SERIAL_DEVICE_" toupper($$0) "_GATE_" gate} END{print out}')
buffer_serial_config = $(shell, basename '$(serial_device,$(1),$(2))' | sed 's/-/_/g' | awk 'BEGIN{out="CHOICE_BUFFER_SERIAL_DEVICE_NONE"} NF && $$0!="." {out="CHOICE_BUFFER_SERIAL_DEVICE_" toupper($$0)} END{print out}')

# Grab UUIDs that are not in use by Klipper from all available CAN interfaces.
# Keep each interface attached to its UUID, e.g. "can0:43a8... vlan1:25ff...".
real_klipper_home   := $(shell, if [ -n "$(REAL_KLIPPER_HOME)" ]; then printf '%s' "$(REAL_KLIPPER_HOME)"; else printf '%s' "$(KLIPPER_HOME)"; fi)
canbus_query        := $(shell, echo "$(real_klipper_home)/../klippy-env/bin/python $(real_klipper_home)/scripts/canbus_query.py")
canbus_interfaces   := $(shell, (ip -o link show type can | awk -F': ' '{print $2}') 2>/dev/null || true)
canbus_connections  := $(shell, (for interface in $(canbus_interfaces); do $(canbus_query) "$interface" | sed -n 's/.*canbus_uuid=\([0-9a-fA-F][0-9a-fA-F]*\).*/\1/p' | while IFS= read -r uuid; do printf '%s:%s\n' "$interface" "$uuid"; done; done) 2>/dev/null || true)
canbus_uuid_count   := $(count, $(canbus_connections))
canbus_connection    = $(shell, echo $(canbus_connections) | awk -v n=$(1) '{ print $n }')
canbus_interface     = $(shell, echo $(canbus_connection,$(1)) | cut -d: -f1)
canbus_uuid          = $(shell, echo $(canbus_connection,$(1)) | cut -d: -f2)
saved_canbus_interface = $(shell, [ -n '$(saved-config-value,$(1))' ] && echo '$(saved-config-value,$(1))' || echo can0)
saved_canbus_connection = $(saved_canbus_interface,$(1)):$(saved-config-value,$(2))
mmu_canbus_config    = $(shell, echo $(canbus_connection,$(1)) | tr ':a-z' '_A-Z' | sed 's/[^A-Z0-9_]/_/g' | awk 'BEGIN{out="CHOICE_MMU_CANBUS_UUID_NONE"} NF {out="CHOICE_MMU_CANBUS_UUID_" $0} END{print out}')
mmu_canbus_config_pg = $(shell, echo $(canbus_connection,$(2)) | tr ':a-z' '_A-Z' | sed 's/[^A-Z0-9_]/_/g' | awk -v gate=$(1) 'BEGIN{out="CHOICE_MMU_CANBUS_UUID_NONE_GATE_" gate} NF {out="CHOICE_MMU_CANBUS_UUID_" $0 "_GATE_" gate} END{print out}')
buffer_canbus_config = $(shell, echo $(canbus_connection,$(1)) | tr ':a-z' '_A-Z' | sed 's/[^A-Z0-9_]/_/g' | awk 'BEGIN{out="CHOICE_BUFFER_CANBUS_UUID_NONE"} NF {out="CHOICE_BUFFER_CANBUS_UUID_" $0} END{print out}')

# Used for comment padding
pad = $(shell, printf "%-$(1)s" "$(2)")

# To allow multiline config strings.
# Important: Use $(comma) & $(quote) instead of real comma's or double quotes in multiline strings
# For portability, this is a posix version of: ml = $(shell, printf "$(1)" | sed -z "s/\\n/\\\\n/g")
comma := ,
quote := "
ml = $(shell, printf '%s' "$(1)" | awk -v ORS='\\n' '1')


### Start of configuration
mainmenu "$(title)"

config HAPPY_HARE_VERSION
  string
  default "$(happy_hare_version)"

config MULTI_UNIT
  bool
  default "$(F_MULTI_UNIT)"

config MULTI_UNIT_ENTRY_POINT
  bool
  default "$(F_MULTI_UNIT_ENTRY_POINT)"

config PER_GATE_MCU
  bool
  default "$(F_PER_GATE_MCU)"

if MULTI_UNIT_ENTRY_POINT || !MULTI_UNIT
  config MMU_UNITS
    string
    default "$(UNIT_NAME)"
endif

if !MULTI_UNIT_ENTRY_POINT
  config UNIT_NAME
    string
    default "$(UNIT_NAME)"

  config MCU_NAME
    string
    default "$(MCU_NAME)"

  config UNIT_INDEX
    int
    default $(shell, echo "${UNIT_INDEX-0}")
endif

# Important to let individual units know of important printer features
if MULTI_UNIT && !MULTI_UNIT_ENTRY_POINT
  config MMU_HAS_SENSOR_TOOLHEAD
    default "$(mmu_has_sensor_toolhead)"
  config MMU_HAS_SENSOR_EXTRUDER
    default "$(mmu_has_sensor_extruder)"
  config MMU_HAS_TOOLHEAD_CUTTER
    default "$(mmu_has_toolhead_cutter)"
endif

comment "$(pad,50,)"
comment "$(pad,50,(\\_/))"
comment "$(pad,50,( *,*))"
comment "$(pad,$(caption_pad),(\")_(\") $(caption))"
comment "$(pad,50,)"
comment "_"

# UI rendering option:
#  y to shows MMU additions menu inline with type
#  n to show as top level menu
config SHOW_MMU_ADDITIONS_WITH_TYPE
  bool
  default n

# Optional auto generated config for shared components to
# adds options for sharing previously defined components
# (like mmu_toolhead, encoder, sync-feedback, ...)
osource "/tmp/.Kconfig.generated"


# -------------------------------------
# Initial menuconfig for multi-unit
# -------------------------------------

if MULTI_UNIT_ENTRY_POINT
  config MMU_UNITS
    prompt "MMU unit names"
    array_editor ","
    help
      Comma-separated list of unit names. Careful: Use only alphanumeric characters.
      If this is the first time configuring multi-unit from previous single-unit install
      then the first name must be unit0 because that is how it was configured.
      E.g. "unit0,unit1"

      A separate configurator will be run for each MMU after this initial screen is closed

  comment "_"
  comment "_Shared System Options"
  source "toolheads/Kconfig"        # Toolhead Selection menu
  source "Kconfig.toolhead"         # Toolhead Sensors/Settings
  source "Kconfig.options"          # Main software options
  source "Kconfig.tip_shaping"
  source "Kconfig.purging"
  source "Kconfig.speeds"           # Access to extruder speeds
  source "macro_vars/Kconfig"       # Variables for all macros

  # These are duplicated settings that are excluded from units when MULTI_UNIT
  menu "Pins"
    help
      Here you can configure per-printer pins such as toolhead sensors and
      additional gantry servo for filament cutter

    source "Kconfig.shared_pins"    # Pins on components shared across units
  endmenu

  source "Kconfig.paths_services"   # Advanced install options
endif


# -------------------------------------
# Per unit config
# -------------------------------------

if !MULTI_UNIT_ENTRY_POINT
  source "mmu_types/Kconfig"        # Base MMU type menu
  source "Kconfig.name"             # Simple display name
  source "boards/Kconfig"           # MCU Selection menu
  if !SHOW_MMU_ADDITIONS_WITH_TYPE
    source "Kconfig.mmu_additions"  # MMU Additions/Customization menu (if not inlined with MMU type)
  endif
  comment "_"
  source "connection/Kconfig"       # MCU Connection
  source "Kconfig.pins"             # Raw pin editing
  if !MULTI_UNIT
    comment "_"
    source "toolheads/Kconfig"      # Toolhead Selection menu
    source "Kconfig.toolhead"       # Toolhead Sensors/Settings
  endif
  source "Kconfig.endstops"         # Important endstops and load/unload distances
  if !MULTI_UNIT
    source "Kconfig.options"        # Main software options
    source "Kconfig.tip_shaping"
    source "Kconfig.purging"
    source "macro_vars/Kconfig"     # Variables for all macros
  endif
  source "Kconfig.other"            # Raw access to other parameters
  if !MULTI_UNIT
    comment "_"
    source "Kconfig.paths_services" # Advanced install options
  endif
endif


# -------------------------------------
# Warning - works for single and multi-unit
# -------------------------------------
source "Kconfig.warnings"
