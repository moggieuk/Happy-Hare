# Per-unit steppers/servo that move filament and select gates, and their speeds
# (Once user edits values here they are sticky and
# will override defaults)

# Declared after the machine types so a type's default comes first. The gate
# count's prompt is under MMU Type -> Design attributes (Kconfig.capabilities)
config PARAM_DESIGN_NUM_GATES
  int
  default 0

menu "MMU Kinematics and Speeds"
  help
    MMU Kinematics and Speeds
    The gear stepper, selector stepper and selector servo, and movement
    speeds. Allows override of designer defaults. Change these settings if
    you know what you are doing (or have MMU customizations)

  if !MULTI_UNIT_ENTRY_POINT
    source "Kconfig.gear_stepper"
    source "Kconfig.selector_stepper"
    source "Kconfig.selector_servo"
    source "Kconfig.speeds"
  endif
endmenu
