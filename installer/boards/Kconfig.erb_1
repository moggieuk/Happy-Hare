config BOARD_TYPE_ERB_1
  bool "Fysetc Burrows ERB v1"

if BOARD_TYPE_ERB_1
  config PARAM_BOARD_TYPE
    default "Fysetc Burrows ERB v1"

  choice CHOICE_MMU_CONNECTION_TYPE
    default CHOICE_MMU_CONNECTION_TYPE_SERIAL
  endchoice
  choice CHOICE_MMU_SERIAL_CONNECTION
    default $(mmu_serial_config,1,rp2040)
  endchoice

  config PIN_GEAR_UART
    default "$(MCU_NAME):gpio20" 
  config PIN_GEAR_STEP
    default "$(MCU_NAME):gpio10" 
  config PIN_GEAR_DIR
    default "!$(MCU_NAME):gpio9" 
  config PIN_GEAR_ENABLE
    default "!$(MCU_NAME):gpio8"
  config PIN_GEAR_DIAG
    default "$(MCU_NAME):gpio13"

  config PIN_SELECTOR_UART
    default "$(MCU_NAME):gpio17" 
  config PIN_SELECTOR_STEP
    default "$(MCU_NAME):gpio16" 
  config PIN_SELECTOR_DIR
    default "!$(MCU_NAME):gpio15" 
  config PIN_SELECTOR_ENABLE
    default "!$(MCU_NAME):gpio14" 
  config PIN_SELECTOR_DIAG
    default "$(MCU_NAME):gpio19"
  config PIN_SELECTOR_ENDSTOP
    default "^$(MCU_NAME):gpio24"
  config PIN_SELECTOR_SERVO
    default "$(MCU_NAME):gpio23" 

  config PIN_ENTRY_SENSOR_0
    default "^$(MCU_NAME):gpio0"
  config PIN_ENTRY_SENSOR_1
    default "^$(MCU_NAME):gpio1"
  config PIN_ENTRY_SENSOR_2
    default "^$(MCU_NAME):gpio2"
  config PIN_ENTRY_SENSOR_3
    default "^$(MCU_NAME):gpio3"
  config PIN_ENTRY_SENSOR_4
    default "^$(MCU_NAME):gpio4"
  config PIN_ENTRY_SENSOR_5
    default "^$(MCU_NAME):gpio5"
  config PIN_ENTRY_SENSOR_6
    default "^$(MCU_NAME):gpio6"
  config PIN_ENTRY_SENSOR_7
    default "^$(MCU_NAME):gpio7"
  config PIN_ENTRY_SENSOR_8
    default "^$(MCU_NAME):gpio26"
  config PIN_ENTRY_SENSOR_9
    default "^$(MCU_NAME):gpio27"
  config PIN_ENTRY_SENSOR_10
    default "^$(MCU_NAME):gpio28"
  config PIN_ENTRY_SENSOR_11
    default "^$(MCU_NAME):gpio29"

  config PIN_ENCODER
    default "^$(MCU_NAME):gpio22" if MMU_HAS_ENCODER
  config PIN_SHARED_EXIT_SENSOR
    default "^$(MCU_NAME):gpio22" if !MMU_HAS_ENCODER
  config PIN_NEOPIXEL
    default "$(MCU_NAME):gpio21"

# No fan headers

  # The I2C1 pins on the EXTRA PINS header: hardware i2c1b, SCL gpio7 / SDA gpio6.
  # They are also entry sensors 6 and 7, so the bus is only free up to six gates
  # The header has no 3.3V: pull-ups to 5V would back-drive the RP2040
  i2c_board       := BOARD_TYPE_ERB_1 && PARAM_NUM_GATES <= 6
  i2c_tag         := ERB_1_I2C1
  i2c_bus         := i2c1b
  i2c_label       := i2c1b [[DIM]]/ I2C1 pins[[/DIM]]
  i2c_env         := y
  i2c_env_default := n
  i2c_nfc         := y
  i2c_nfc_default := n
  source "components/Kconfig.i2c_board_bus"
endif
