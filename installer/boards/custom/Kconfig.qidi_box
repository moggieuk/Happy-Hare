config BOARD_TYPE_QIDI_BOX_2_0
  bool "QIDI Box v2 MCU"
  help
    Stock QIDI Box controller based on an STM32F401xC and connected over
    USB serial. When building mainline Klipper firmware, select the
    STM32F401xC and the 32KiB bootloader/0x8000 flash offset
    (CONFIG_STM32_FLASH_START_8000).

if BOARD_TYPE_QIDI_BOX_2_0
  config PARAM_BOARD_TYPE
    default "QIDI Box v2 (STM32F401xC)"

  choice CHOICE_MMU_CONNECTION_TYPE
    default CHOICE_MMU_CONNECTION_TYPE_SERIAL
  endchoice
  choice CHOICE_MMU_SERIAL_CONNECTION
    # Stock firmware: usb-Klipper_QIDI_BOX_V2_*
    default $(mmu_serial_config,1,QIDI_BOX) if $(serial_exists,1,QIDI_BOX)
    # Mainline firmware: usb-Klipper_stm32f401xc_*
    default $(mmu_serial_config,1,stm32f401xc) if $(serial_exists,1,stm32f401xc)
    default $(mmu_serial_config,1,stm32)
  endchoice

  # The stock drivers expose only step, direction and enable. Motor current
  # is configured in hardware; there are no UART or DIAG connections.
  config PIN_GEAR_STEP
    default "$(MCU_NAME):PC14"
  config PIN_GEAR_DIR
    default "$(MCU_NAME):PC13"
  config PIN_GEAR_ENABLE
    default "!$(MCU_NAME):PC15"

  config PIN_GEAR_STEP_1
    default "$(MCU_NAME):PB9"
  config PIN_GEAR_DIR_1
    default "$(MCU_NAME):PB8"
  config PIN_GEAR_ENABLE_1
    default "!$(MCU_NAME):PC0"

  config PIN_GEAR_STEP_2
    default "$(MCU_NAME):PC12"
  config PIN_GEAR_DIR_2
    default "$(MCU_NAME):PC11"
  config PIN_GEAR_ENABLE_2
    default "!$(MCU_NAME):PD2"

  config PIN_GEAR_STEP_3
    default "$(MCU_NAME):PC8"
  config PIN_GEAR_DIR_3
    default "$(MCU_NAME):PB2"
  config PIN_GEAR_ENABLE_3
    default "!$(MCU_NAME):PC10"

  config PIN_ENTRY_SENSOR_0
    default "!$(MCU_NAME):PA0"
  config PIN_ENTRY_SENSOR_1
    default "!$(MCU_NAME):PB3"
  config PIN_ENTRY_SENSOR_2
    default "!$(MCU_NAME):PA13"
  config PIN_ENTRY_SENSOR_3
    default "!$(MCU_NAME):PA7"

  config PIN_SHARED_EXIT_SENSOR
    default "^!$(MCU_NAME):PB1"
  config PIN_BUFFER_TENSION
    default "^$(MCU_NAME):PB0"

  # The filament switch is on the printer's THR head MCU, not this board.
  config PIN_EXTRUDER_SENSOR
    default "!THR:PA1"


  # The dryer's AHT sensor is wired to PA8/PC9. Mainline Klipper names that
  # hardware bus "i2c3" on the STM32F4, not the generic default
  # i2c2_PB10_PB11 (which would fail with "Unknown i2c_bus"), so the board
  # drives it as software i2c on the same pins.
  choice CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_TYPE
    default CHOICE_ENVIRONMENT_SENSOR_I2C_SOFTWARE
  endchoice
  config PIN_ENVIRONMENT_SENSOR_SCL
    default "PA8"
  config PIN_ENVIRONMENT_SENSOR_SDA
    default "PC9"


  # -------------------------------------
  # Custom NFC reader setup
  # Two FM1780 readers (Fudan) sit on SPI2 and differ only by chip select:
  # PC6 covers gates 0/1, PC7 covers gates 2/3. They are register compatible
  # with the MFRC522, so the rc522 driver drives them unchanged.
  #
  # NRSTPD is wired to PB12. The rc522 driver only ever soft-resets over SPI,
  # so unless that line is driven high the chips stay in reset and every
  # register reads back 0xFF.
  # -------------------------------------

  config CUSTOM_NFC_READER_SETUP
    def_bool y
mh_nfc_reader_qidi_box := \
# NFC readers are held in reset until NRSTPD is driven high\n\
[output_pin $(UNIT_NAME)_nfc_rst]\n\
pin: $(MCU_NAME):PB12\n\
value: 1\n\
shutdown_value: 1\n\
\n\
# NFC reader gates 0/1\n\
[mmu_nfc_reader $(UNIT_NAME)_nfc01]\n\
reader_type           : rc522\n\
cs_pin                : $(MCU_NAME):PC6\n\
spi_bus               : spi2_PB14_PB15_PB13\n\
spi_speed             : 1000000\n\
debug                 : 0\n\
\n\
# NFC reader gates 2/3\n\
[mmu_nfc_reader $(UNIT_NAME)_nfc23]\n\
reader_type           : rc522\n\
cs_pin                : $(MCU_NAME):PC7\n\
spi_bus               : spi2_PB14_PB15_PB13\n\
spi_speed             : 1000000\n\
debug                 : 0\n\
\n\


  # -------------------------------------
  # Dryer heater
  # No CUSTOM_HEATER_SETUP: that would hide the heater name prompt and
  # discard the name of a heater an existing user wrote by hand.
  # Mainline's AHT driver reports every 5s at best, too slow for a heater
  # (3s watchdog), so temperature_combined re-reports the environment
  # sensor every 0.3s. sensor_list must match PARAM_ENVIRONMENT_SENSOR.
  # The PID values are QIDI's, tuned on a faster sensor: run PID_CALIBRATE.
  # The two thermistors on the heater element are monitors only.
  # -------------------------------------

mh_heater_qidi_box := \
[heater_generic $(UNIT_NAME)_heater]\n\
heater_pin: $(MCU_NAME):PA3\n\
sensor_type: temperature_combined\n\
sensor_list: temperature_sensor $(UNIT_NAME)_Env\n\
combination_method: mean\n\
maximum_deviation: 50\n\
control: pid\n\
pid_Kp: 63.418\n\
pid_Ki: 1.342\n\
pid_Kd: 749.125\n\
min_temp: -100\n\
max_temp: 100\n\
\n\
[verify_heater $(UNIT_NAME)_heater]\n\
max_error: 400\n\
check_gain_time: 600\n\
\n\
[temperature_sensor $(UNIT_NAME)_heater_temp_a]\n\
sensor_type: NTC 100K MGB18-104F39050L32\n\
sensor_pin: $(MCU_NAME):PC1\n\
min_temp: -100\n\
max_temp: 130\n\
\n\
[temperature_sensor $(UNIT_NAME)_heater_temp_b]\n\
sensor_type: NTC 100K MGB18-104F39050L32\n\
sensor_pin: $(MCU_NAME):PC2\n\
min_temp: -100\n\
max_temp: 130\n\
\n\


  # -------------------------------------
  # Dryer heater fans
  # No CUSTOM_HEATER_FAN_SETUP: that would hide, and discard, a heater
  # fan pin an existing user set in menuconfig. Two fans, one heater.
  # -------------------------------------

mh_heater_fan_qidi_box := \
[heater_fan $(UNIT_NAME)_heater_fan_a]\n\
pin: $(MCU_NAME):PA4\n\
heater: $(UNIT_NAME)_heater\n\
heater_temp: 35\n\
\n\
[heater_fan $(UNIT_NAME)_heater_fan_b]\n\
pin: $(MCU_NAME):PA5\n\
heater: $(UNIT_NAME)_heater\n\
heater_temp: 35\n\
\n\


  # -------------------------------------
  # Board fan
  # Runs with the gear steppers, and with the dryer heater when there is
  # one (the board sits inside the heated box)
  # -------------------------------------

mh_controller_fan_qidi_box := \
[controller_fan $(UNIT_NAME)_board_fan]\n\
pin: $(MCU_NAME):PA6\n\
stepper: mmu_stepper $(UNIT_NAME)_gear$(comma) mmu_stepper $(UNIT_NAME)_gear_1$(comma) mmu_stepper $(UNIT_NAME)_gear_2$(comma) mmu_stepper $(UNIT_NAME)_gear_3\n\


  config PARAM_MISC_HARDWARE
    default "$(ml,$(mh_nfc_reader_qidi_box)$(mh_heater_qidi_box)$(mh_heater_fan_qidi_box)$(mh_controller_fan_qidi_box)heater: $(UNIT_NAME)_heater\n)" if MMU_HAS_HEATER && MMU_HAS_ENVIRONMENT_SENSOR
    default "$(ml,$(mh_nfc_reader_qidi_box)$(mh_controller_fan_qidi_box))"

endif
