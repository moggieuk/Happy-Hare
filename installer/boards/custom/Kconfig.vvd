config BOARD_TYPE_VVD_1_0
  bool "BTT ViViD MCU"

if BOARD_TYPE_VVD_1_0
  config PARAM_BOARD_TYPE
    default "BTT ViViD v1"

  choice CHOICE_MMU_CONNECTION_TYPE
    default CHOICE_MMU_CONNECTION_TYPE_SERIAL
  endchoice
  choice CHOICE_MMU_SERIAL_CONNECTION
    default $(mmu_serial_config,1,stm32)
  endchoice
  choice CHOICE_BUFFER_CONNECTION_TYPE
    default CHOICE_BUFFER_CONNECTION_TYPE_SERIAL
  endchoice
  choice CHOICE_BUFFER_SERIAL_CONNECTION
    default $(buffer_serial_config,1,stm32)
  endchoice

  config PIN_SELECTOR_UART
    default "$(MCU_NAME):PB3"
  config PIN_SELECTOR_STEP
    default "$(MCU_NAME):PD3"
  config PIN_SELECTOR_DIR
    default "$(MCU_NAME):PD2"
  config PIN_SELECTOR_ENABLE
    default "!$(MCU_NAME):PB4"

  config PIN_GATE_ENDSTOP_0
    default "!$(MCU_NAME):PD0"
  config PIN_GATE_ENDSTOP_1
    default "!$(MCU_NAME):PA15"
  config PIN_GATE_ENDSTOP_2
    default "!$(MCU_NAME):PD1"
  config PIN_GATE_ENDSTOP_3
    default "!$(MCU_NAME):PC13"

  config PIN_GEAR_UART
    default "$(MCU_NAME):PB7"
  config PIN_GEAR_STEP
    default "$(MCU_NAME):PB6"
  config PIN_GEAR_DIR
    default "$(MCU_NAME):PB5"
  config PIN_GEAR_ENABLE
    default "!$(MCU_NAME):PB8"

  config PIN_ENTRY_SENSOR_0
    default "$(MCU_NAME):PA0"
  config PIN_ENTRY_SENSOR_1
    default "$(MCU_NAME):PA1"
  config PIN_ENTRY_SENSOR_2
    default "$(MCU_NAME):PA2"
  config PIN_ENTRY_SENSOR_3
    default "$(MCU_NAME):PA3"


  # -------------------------------------
  # Custom LED setup
  # -------------------------------------

  config CUSTOM_LED_SETUP
    def_bool y
misc_hardware_led := \
[neopixel $(UNIT_NAME)_leds_1]\n\
pin: $(MCU_NAME):PC6\n\
chain_count: 14\n\
color_order: GRB\n\
\n\
[neopixel $(UNIT_NAME)_leds_2]\n\
pin: $(MCU_NAME):PC7\n\
chain_count: 14\n\
color_order: GRB\n\
\n\


  # -------------------------------------
  # Custom Environment sensor setup
  # -------------------------------------

  config CUSTOM_ENVIRONMENT_SENSOR_SETUP
    def_bool y
misc_hardware_environment_sensor := \
[temperature_sensor $(UNIT_NAME)_env_left]\n\
sensor_type: AHT3X # Use an AHT10 and set klipper option 'update_aht10_commands: 1' if the AHT3X sensor_type isn't supported (older Klipper versions)\n\
i2c_mcu: $(MCU_NAME)\n\
i2c_software_scl_pin: $(MCU_NAME):PA9\n\
i2c_software_sda_pin: $(MCU_NAME):PA10\n\
aht10_report_time: 10\n\
\n\
[temperature_sensor $(UNIT_NAME)_env_right]\n\
sensor_type: AHT3X # Use an AHT10 and set klipper option 'update_aht10_commands: 1' if the AHT3X sensor_type isn't supported (older Klipper versions)\n\
i2c_mcu: $(MCU_NAME)\n\
i2c_software_scl_pin: $(MCU_NAME):PA7\n\
i2c_software_sda_pin: $(MCU_NAME):PA6\n\
aht10_report_time: 10\n\
\n\


  # -------------------------------------
  # Custom heater setup
  # -------------------------------------

  config CUSTOM_HEATER_SETUP
    def_bool y
misc_hardware_heater := \
[heater_generic $(UNIT_NAME)_heater]\n\
gcode_id:  $(UNIT_NAME)_heater\n\
heater_pin: $(MCU_NAME):PC14\n\
sensor_type: temperature_combined\n\
sensor_list: temperature_sensor $(UNIT_NAME)_env_left$(comma) temperature_sensor $(UNIT_NAME)_env_right\n\
combination_method: mean\n\
maximum_deviation: 100\n\
control: pid\n\
pid_Kp: 51.604\n\
pid_Ki: 1.121\n\
pid_Kd: 593.934\n\
min_temp: -100\n\
max_temp: 70\n\
\n\
[verify_heater $(UNIT_NAME)_heater]\n\
max_error: 300\n\
check_gain_time: 600\n\
hysteresis: 10\n\
heating_gain: 1\n\
\n\
[temperature_sensor $(UNIT_NAME)_ptc_ntc100k]\n\
sensor_pin: $(MCU_NAME):PA4\n\
sensor_type: Generic 3950\n\
pullup_resistor: 2200\n\
\n\


  # -------------------------------------
  # Custom heater fan setup
  # Note: this could use default set mechanism but could cause upgrade issues
  # -------------------------------------

  config CUSTOM_HEATER_FAN_SETUP
    def_bool y
misc_hardware_heater_fan := \
[heater_fan $(UNIT_NAME)_fan]\n\
pin: $(MCU_NAME):PC15\n\
shutdown_speed: 0\n\
heater: $(UNIT_NAME)_heater\n\
\n\


  # -------------------------------------
  # Custom controller fan setup
  # -------------------------------------

  config CUSTOM_FAN_SETUP
    def_bool y
misc_hardware_fan := \
# Electronics cooling fan\n\
[controller_fan $(UNIT_NAME)_mcu_fan]\n\
pin: $(MCU_NAME):PA14\n\
stepper: mmu_stepper $(UNIT_NAME)_selector$(comma) mmu_stepper $(UNIT_NAME)_gear\n\
\n\


  # -------------------------------------
  # Custom NFC reader setup
  # -------------------------------------

  config CUSTOM_NFC_READER_SETUP
    def_bool y
misc_hardware_nfc_reader := \
# NFC reader gates 0/1\n\
[mmu_nfc_reader $(UNIT_NAME)_nfc01]\n\
reader_type           : rc522\n\
cs_pin                : $(MCU_NAME):PB14\n\
spi_bus               : spi2_PB2_PB11_PB10\n\
spi_speed             : 1000000\n\
debug                 : 0\n\
\n\
# NFC reader gates 2/3\n\
[mmu_nfc_reader $(UNIT_NAME)_nfc23]\n\
reader_type           : rc522\n\
cs_pin                : $(MCU_NAME):PA8\n\
spi_bus               : spi2_PB2_PB11_PB10\n\
spi_speed             : 1000000\n\
debug                 : 0\n\

  config PARAM_MISC_HARDWARE
    default "$(ml,$(misc_hardware_led)$(misc_hardware_environment_sensor)$(misc_hardware_heater)$(misc_hardware_heater_fan)$(misc_hardware_fan)$(misc_hardware_nfc_reader))"


  # -------------------------------------
  # Buffer
  # -------------------------------------

  if OPTION_VVD_BUFFER
    config PIN_EXIT_SENSOR_0
      default "$(MCU_NAME)_buffer:PA0"
    config PIN_EXIT_SENSOR_1
      default "$(MCU_NAME)_buffer:PA1"
    config PIN_EXIT_SENSOR_2
      default "$(MCU_NAME)_buffer:PA2"
    config PIN_EXIT_SENSOR_3
      default "$(MCU_NAME)_buffer:PA3"

    config PIN_BUFFER_TENSION
      default "$(MCU_NAME)_buffer:PA4"
    config PIN_BUFFER_COMPRESSION
      default "$(MCU_NAME)_buffer:PA5"
  endif

endif
