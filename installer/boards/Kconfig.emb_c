# EMB-C is a CAN-connected, single-MCU board for an EMU with two to five
# independently driven gates.  It assumes the standard Front Button PCB:
# five GRBW LEDs and a normally-open eject button on each lane.

config BOARD_TYPE_EMB_C
  bool "EMB-C v1 / designed for EMU"
  depends on MMU_TYPE_EMU_1_0
  help
    Single-MCU CAN board for a 2-5 lane EMU. Requires the Front Button PCB.

if BOARD_TYPE_EMB_C
  config PARAM_BOARD_TYPE
    default "EMU EMB-C"

  config BOOL_EXTERNAL_PER_GATE_ENVIRONMENT_SENSORS
    default y

  choice CHOICE_MMU_CONNECTION_TYPE
    default CHOICE_MMU_CONNECTION_TYPE_CANBUS
  endchoice
  choice CHOICE_MMU_SERIAL_CONNECTION
    default $(mmu_serial_config,1,stm32)
  endchoice

  # The EMU type exposes the gate count and defaults to five. EMB-C has
  # physical interfaces for two to five lanes; choose a value in that range
  # in Design attributes.

  # Gear steppers. Gear 3 and gear 4 share PC0 and use TMC2209 UART
  # addresses 0 and 1 respectively.
  config PIN_GEAR_UART
    default "$(MCU_NAME):PC4"
  config PIN_GEAR_STEP
    default "$(MCU_NAME):PA7"
  config PIN_GEAR_DIR
    default "!$(MCU_NAME):PA6"
  config PIN_GEAR_ENABLE
    default "!$(MCU_NAME):PC5"
  config PIN_GEAR_DIAG
    default ""

  config PIN_GEAR_UART_1
    default "$(MCU_NAME):PA4"
  config PIN_GEAR_STEP_1
    default "$(MCU_NAME):PA3"
  config PIN_GEAR_DIR_1
    default "!$(MCU_NAME):PA2"
  config PIN_GEAR_ENABLE_1
    default "!$(MCU_NAME):PA5"
  config PIN_GEAR_DIAG_1
    default ""

  config PIN_GEAR_UART_2
    default "$(MCU_NAME):PA0"
  config PIN_GEAR_STEP_2
    default "$(MCU_NAME):PC3"
  config PIN_GEAR_DIR_2
    default "!$(MCU_NAME):PC2"
  config PIN_GEAR_ENABLE_2
    default "!$(MCU_NAME):PA1"
  config PIN_GEAR_DIAG_2
    default ""

  config PIN_GEAR_UART_3
    default "$(MCU_NAME):PC0"
  config PIN_GEAR_STEP_3
    default "$(MCU_NAME):PC15"
  config PIN_GEAR_DIR_3
    default "!$(MCU_NAME):PC14"
  config PIN_GEAR_ENABLE_3
    default "!$(MCU_NAME):PC1"
  config PIN_GEAR_DIAG_3
    default ""

  config PIN_GEAR_UART_4
    default "$(MCU_NAME):PC0"
  config PARAM_GEAR_UART_ADDRESS_4
    default 1
  config PIN_GEAR_STEP_4
    default "$(MCU_NAME):PC11"
  config PIN_GEAR_DIR_4
    default "!$(MCU_NAME):PC10"
  config PIN_GEAR_ENABLE_4
    default "!$(MCU_NAME):PC13"
  config PIN_GEAR_DIAG_4
    default ""

  # Per-lane filament switches. The board does not provide pull-ups.
  config PIN_ENTRY_SENSOR_0
    default "^$(MCU_NAME):PA8"
  config PIN_ENTRY_SENSOR_1
    default "^$(MCU_NAME):PD2"
  config PIN_ENTRY_SENSOR_2
    default "^$(MCU_NAME):PD4"
  config PIN_ENTRY_SENSOR_3
    default "^$(MCU_NAME):PD6"
  config PIN_ENTRY_SENSOR_4
    default "^$(MCU_NAME):PB4"

  config PIN_EXIT_SENSOR_0
    default "^$(MCU_NAME):PA9"
  config PIN_EXIT_SENSOR_1
    default "^$(MCU_NAME):PD3"
  config PIN_EXIT_SENSOR_2
    default "^$(MCU_NAME):PD5"
  config PIN_EXIT_SENSOR_3
    default "^$(MCU_NAME):PB3"
  config PIN_EXIT_SENSOR_4
    default "^$(MCU_NAME):PB5"

  # The Front Button PCB is normally open; invert its pull-up inputs.
  config PIN_EJECT_BUTTON_0
    default "^!$(MCU_NAME):PA10"
  config PIN_EJECT_BUTTON_1
    default "^!$(MCU_NAME):PD9"
  config PIN_EJECT_BUTTON_2
    default "^!$(MCU_NAME):PD8"
  config PIN_EJECT_BUTTON_3
    default "^!$(MCU_NAME):PC7"
  config PIN_EJECT_BUTTON_4
    default "^!$(MCU_NAME):PC6"

  # FAN1..5 are circulation fans. Happy Hare's per-gate managed-fan
  # configuration uses the shared MCU temperature to start or stop them.
  # EMB-C has no separate controller or heater fan outputs.
  config PIN_FAN_0
    default "$(MCU_NAME):PA13"
  config PIN_FAN_1
    default "$(MCU_NAME):PB15"
  config PIN_FAN_2
    default "$(MCU_NAME):PB14"
  config PIN_FAN_3
    default "$(MCU_NAME):PB13"
  config PIN_FAN_4
    default "$(MCU_NAME):PB1"

  if OPTION_PSF_BUFFER
    config PIN_BUFFER_ANALOG
      default "$(MCU_NAME):PB0"
  endif

  # One five-pixel GRBW chain per lane. The Front Button PCB places the
  # exit LEDs at positions 1-4 and the entry LED at position 5.
  config PIN_NEOPIXEL_0
    default "$(MCU_NAME):PA15"
  config PIN_NEOPIXEL_1
    default "$(MCU_NAME):PC8"
  config PIN_NEOPIXEL_2
    default "$(MCU_NAME):PC9"
  config PIN_NEOPIXEL_3
    default "$(MCU_NAME):PD0"
  config PIN_NEOPIXEL_4
    default "$(MCU_NAME):PD1"
  config PARAM_CHAIN_COUNT
    default 5
  config PARAM_ENTRY_LEDS
    generated_default "neopixel:_$(UNIT_NAME)_gate%i_leds (5)" "" "; " PARAM_NUM_GATES
  config PARAM_EXIT_LEDS
    generated_default "neopixel:_$(UNIT_NAME)_gate%i_leds (1,2,3,4)" "" "; " PARAM_NUM_GATES

endif
