config BOARD_TYPE_EBB_GEN1
  bool "BTT EBB 42 CANbus V1.2"

if BOARD_TYPE_EBB_GEN1
  config PARAM_BOARD_TYPE
    default "BTT EBB42 v1.2"
  
  choice CHOICE_MMU_CONNECTION_TYPE
    default CHOICE_MMU_CONNECTION_TYPE_SERIAL
  endchoice
  choice CHOICE_MMU_SERIAL_CONNECTION
    default $(mmu_serial_config,1,)
  endchoice

  config PIN_GEAR_UART 
    default "$(MCU_NAME):PA15" 
  config PIN_GEAR_STEP
    default "$(MCU_NAME):PD0" 
  config PIN_GEAR_DIR
    default "$(MCU_NAME):PD1" 
  config PIN_GEAR_ENABLE
    default "!$(MCU_NAME):PD2" 

  config PIN_SELECTOR_SERVO
    default "$(MCU_NAME):PB9"

  config PIN_ENTRY_SENSOR_0
    default "^$(MCU_NAME):PB7" 
  config PIN_ENTRY_SENSOR_1
    default "^$(MCU_NAME):PB5" 
  config PIN_ENTRY_SENSOR_2
    default "^$(MCU_NAME):PB6" 
  config PIN_ENTRY_SENSOR_3
    default "^$(MCU_NAME):PB8"

  config PIN_NEOPIXEL
    default "$(MCU_NAME):PD3" 
  config PIN_SHARED_EXIT_SENSOR
    default "^$(MCU_NAME):PB4" if !MMU_HAS_ENCODER

  # Fan headers (VIN): FAN1 managed fan, FAN2 controller fan
  config PIN_FAN
    default "$(MCU_NAME):PA0"
  config PIN_CONTROLLER_FAN
    default "$(MCU_NAME):PA1"

  # Hardware i2c3 on PB3/PB4, the bus the per-gate EBB offers too
  choice CHOICE_ENVIRONMENT_SENSOR_I2C_BUS
    default CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_EBB_I2C3_PB3_PB4

    config CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_EBB_I2C3_PB3_PB4
      bool "i2c3_PB3_PB4"
      depends on BOARD_TYPE_EBB_GEN1
  endchoice
  config PARAM_ENVIRONMENT_SENSOR_I2C_BUS
    default "i2c3_PB3_PB4" if CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_EBB_I2C3_PB3_PB4

  # Offered but not preselected: an NFC reader has always defaulted to the MCU's default bus
  choice CHOICE_NFC_READER_I2C_BUS
    config CHOICE_NFC_READER_I2C_BUS_EBB_I2C3_PB3_PB4
      bool "i2c3_PB3_PB4"
      depends on BOARD_TYPE_EBB_GEN1
  endchoice
  config PARAM_NFC_READER_I2C_BUS
    default "i2c3_PB3_PB4" if CHOICE_NFC_READER_I2C_BUS_EBB_I2C3_PB3_PB4

# Heater output for a [heater_generic]: HE0 PB13. Thermistor: TH0 PA3
endif
