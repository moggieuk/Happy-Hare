menu "Paths & Services"
  help 
    Advanced
    If you have a non-standard install of Klipper or Moonraker you can configure
    paths and service names here in addition to some other miscellaneous system options

  config REPETIER
    bool "Enable Repetier support?"
    help
      Enable ONLY if you need Repetier support otherwise leave disabled

  config REPETIER_NAME
    string "Repetier name"
    depends on REPETIER

  config OCTOPRINT
    bool "Enable Octoprint support?"
    help
      Enable ONLY if you need to use Octoprint otherwise recommended to leave disabled

  config PARAM_HAPPY_HARE_HOME
    string "Happy Hare directory    "
    default "$(SRC)"

  config KLIPPER_HOME
    string "Klipper directory       "
    default "$(CONFIG_KLIPPER_HOME)" if $(nonempty,$(CONFIG_KLIPPER_HOME))
    default "/usr/share/klipper"     if $(path-is-dir,/usr/share/klipper)
    default "~/klipper"

  config MOONRAKER_HOME
    string "Moonraker directory     "
    depends on !OCTOPRINT
    default "$(CONFIG_MOONRAKER_HOME)" if $(nonempty,$(CONFIG_MOONRAKER_HOME))
    default "/usr/data/moonraker"      if $(path-exists,/usr/data/moonraker)
    default "~/moonraker"

  config KLIPPER_CONFIG_HOME
    string "Klipper config directory"
    default "~" if OCTOPRINT
    default "$(CONFIG_KLIPPER_CONFIG_HOME)" if $(nonempty,$(CONFIG_KLIPPER_CONFIG_HOME))
    default "/usr/data/printer_data/config" if $(path-exists,/usr/data/printer_data)
    default "~/printer_data/config"

  config PARAM_GCODES_PATH
    string "Gcodes directory        "
    default "/usr/data/printer_data/gcodes" if $(path-exists,/usr/data/printer_data)
    default "~/printer_data/gcodes"

  config PRINTER_CONFIG_FILE
    string "Printer config file     "
    depends on !REPETIER
    default "printer.cfg"

  config MOONRAKER_CONFIG_FILE
    string "Moonraker config file   "
    default "moonraker.conf"

  menuconfig BOOL_CUSTOM_SAVE_VARIABLES
    bool "Use your own [save_variables]?"
    default n
    help
      Happy Hare normally adds a [save_variables] section using
      mmu/mmu_vars.cfg. Klipper uses only one save_variables file.
      Enable if your printer.cfg already defines [save_variables]:
      Happy Hare then won't add its own. Set the path below to the
      file your section uses and add 'mmu__revision = 0' to it.

  config PARAM_MMU_VARS_CFG
    string
    prompt "save_variables path     " if BOOL_CUSTOM_SAVE_VARIABLES
    default "$(path-join,$(CONFIG_KLIPPER_CONFIG_HOME),mmu/mmu_vars.cfg)" if $(nonempty,$(CONFIG_KLIPPER_CONFIG_HOME))
    default "/usr/data/printer_data/config/mmu/mmu_vars.cfg" if $(path-exists,/usr/data/printer_data)
    default "~/printer_data/config/mmu/mmu_vars.cfg"
    keep_when_hidden
    help
      The file your [save_variables] section uses. Happy Hare persists
      its calibration and state there and migrates it when units
      are renamed, removed or reordered.

  config SERVICE_KLIPPER
    string "Klipper service name    "
    depends on !REPETIER
    default "${CONFIG_SERVICE_KLIPPER}" if $(nonempty,$(CONFIG_SERVICE_KLIPPER))
    default "klipper.service"           if INIT_SYSTEMD
    default "klipper_service"

  config SERVICE_MOONRAKER
    string "Moonraker service name  "
    depends on !OCTOPRINT
    default "moonraker.service" if INIT_SYSTEMD 
    default "moonraker_service"

  config INIT_SYSTEMD
    bool "Systemd"
    default $(path-is-dir,/etc/systemd/system)
    help
      Set if host computer using /etc/systemd/system for service restart

endmenu
