# Per-gate hardware configuration for modular MMU designs.
#
# MMU_HAS_PER_GATE_CONFIG controls this presentation and the gate-aligned
# environment/heater/fan associations. It is intentionally independent of
# MMU_HAS_PER_GATE_MCU, which describes the MCU connection topology.

if MMU_HAS_PER_GATE_CONFIG

  comment "_"
  comment "_Per-gate config"

  @repeat var=i min=0 max=11@
    if PARAM_NUM_GATES > $(i)

      menu "Gate $(i) config"
        help
          Configure the environment sensor, heater, and fans for gate $(i).

        # -------------------------------------
        # Environment sensor
        # -------------------------------------

        if MMU_HAS_ENVIRONMENT_SENSOR && !CUSTOM_ENVIRONMENT_SENSOR_SETUP

          config PARAM_ENVIRONMENT_SENSOR_$(i)
            string

          menuconfig PARAM_ENVIRONMENT_SENSOR_GATE_$(i)
            bool "Environment sensor"
            default y
            help
              Create an environment sensor for this gate.

          if PARAM_ENVIRONMENT_SENSOR_GATE_$(i)

            config PARAM_ENVIRONMENT_SENSOR_$(i)
              string "Sensor name       "
              default "$(UNIT_NAME)_Env$(i)"
              help
                Name of the environment sensor section in the printer config.

            choice CHOICE_ENVIRONMENT_SENSOR_TYPE_$(i)
              prompt "Sensor type       "
              default CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT2X_$(i)
              help
                Select the environment sensor type used by this gate.
                AHT1X/AHT2X/AHT3X need Klipper newer than v0.13.0 or Kalico v2026.06+
                Use AHT10 on older firmware

              config CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT10_$(i)
                bool "AHT10 [[DIM]]/ older Klipper[[/DIM]]"

              config CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT1X_$(i)
                bool "AHT1X"

              config CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT2X_$(i)
                bool "AHT2X"

              config CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT3X_$(i)
                bool "AHT3X"

              config CHOICE_ENVIRONMENT_SENSOR_TYPE_BME280_$(i)
                bool "BME280 [[DIM]]/ BMP180 / BMP280 / BMP388 / BME680[[/DIM]]"

              config CHOICE_ENVIRONMENT_SENSOR_TYPE_HTU21D_$(i)
                bool "HTU21D"

              config CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7013_$(i)
                bool "SI7013 [[DIM]]/ HTU21D family[[/DIM]]"

              config CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7020_$(i)
                bool "SI7020 [[DIM]]/ HTU21D family[[/DIM]]"

              config CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7021_$(i)
                bool "SI7021 [[DIM]]/ HTU21D family[[/DIM]]"

              config CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT21_$(i)
                bool "SHT21 [[DIM]]/ HTU21D family[[/DIM]]"

              config CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT3X_$(i)
                bool "SHT3X"

              config CHOICE_ENVIRONMENT_SENSOR_TYPE_LM75_$(i)
                bool "LM75 [[DIM]]/ temperature only[[/DIM]]"
            endchoice

            config PARAM_ENVIRONMENT_SENSOR_TYPE_$(i)
              string
              default "AHT10"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT10_$(i)
              default "AHT1X"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT1X_$(i)
              default "AHT2X"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT2X_$(i)
              default "AHT3X"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT3X_$(i)
              default "BME280" if CHOICE_ENVIRONMENT_SENSOR_TYPE_BME280_$(i)
              default "HTU21D" if CHOICE_ENVIRONMENT_SENSOR_TYPE_HTU21D_$(i)
              default "SI7013" if CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7013_$(i)
              default "SI7020" if CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7020_$(i)
              default "SI7021" if CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7021_$(i)
              default "SHT21"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT21_$(i)
              default "SHT3X"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT3X_$(i)
              default "LM75"   if CHOICE_ENVIRONMENT_SENSOR_TYPE_LM75_$(i)

            config PARAM_SENSOR_REPORT_TIME_PARAM_$(i)
              string
              default "aht10_report_time"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT10_$(i) || CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT1X_$(i) || CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT2X_$(i) || CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT3X_$(i)
              default "htu21d_report_time" if CHOICE_ENVIRONMENT_SENSOR_TYPE_HTU21D_$(i) || CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7013_$(i) || CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7020_$(i) || CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7021_$(i) || CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT21_$(i)
              default "sht3x_report_time"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT3X_$(i)
              default "lm75_report_time"   if CHOICE_ENVIRONMENT_SENSOR_TYPE_LM75_$(i)
              default ""

            config PARAM_ENVIRONMENT_SENSOR_REPORT_TIME_$(i)
              int "Report time (secs)" if PARAM_SENSOR_REPORT_TIME_PARAM_$(i) != ""
              default 0  if CHOICE_ENVIRONMENT_SENSOR_TYPE_BME280_$(i)
              default 60
              range 0 300     if CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT3X_$(i) || CHOICE_ENVIRONMENT_SENSOR_TYPE_LM75_$(i)
              range 0 0 5 300
              help
                Seconds between sensor readings (default 60 seconds)

                0 leaves the option out so Klipper uses its own default
                (30 secs; 1 sec for SHT3X, 0.8 secs for LM75).
                Otherwise at least 5 secs (1 sec for SHT3X and LM75).

            if PARAM_SENSOR_REPORT_TIME_PARAM_$(i) = "htu21d_report_time"
              choice CHOICE_ENVIRONMENT_SENSOR_HTU21D_RESOLUTION_$(i)
                prompt "Resolution        "
                default CHOICE_ENVIRONMENT_SENSOR_HTU21D_RESOLUTION_DEFAULT_$(i)
                help
                  Measurement resolution (htu21d_resolution). "Klipper default"
                  leaves the option out, so Klipper uses TEMP12_HUM08.

                config CHOICE_ENVIRONMENT_SENSOR_HTU21D_RESOLUTION_DEFAULT_$(i)
                  bool "Klipper default"

                config CHOICE_ENVIRONMENT_SENSOR_HTU21D_RESOLUTION_TEMP14_HUM12_$(i)
                  bool "TEMP14_HUM12"

                config CHOICE_ENVIRONMENT_SENSOR_HTU21D_RESOLUTION_TEMP13_HUM10_$(i)
                  bool "TEMP13_HUM10"

                config CHOICE_ENVIRONMENT_SENSOR_HTU21D_RESOLUTION_TEMP12_HUM08_$(i)
                  bool "TEMP12_HUM08"

                config CHOICE_ENVIRONMENT_SENSOR_HTU21D_RESOLUTION_TEMP11_HUM11_$(i)
                  bool "TEMP11_HUM11"
              endchoice

              config PARAM_ENVIRONMENT_SENSOR_HTU21D_RESOLUTION_$(i)
                string
                default "TEMP14_HUM12" if CHOICE_ENVIRONMENT_SENSOR_HTU21D_RESOLUTION_TEMP14_HUM12_$(i)
                default "TEMP13_HUM10" if CHOICE_ENVIRONMENT_SENSOR_HTU21D_RESOLUTION_TEMP13_HUM10_$(i)
                default "TEMP12_HUM08" if CHOICE_ENVIRONMENT_SENSOR_HTU21D_RESOLUTION_TEMP12_HUM08_$(i)
                default "TEMP11_HUM11" if CHOICE_ENVIRONMENT_SENSOR_HTU21D_RESOLUTION_TEMP11_HUM11_$(i)
                default ""

              config PARAM_ENVIRONMENT_SENSOR_HTU21D_HOLD_MASTER_$(i)
                boolint "Hold master mode  "
                default 0
                help
                  Read with hold master mode commands (htu21d_hold_master).
                  Leave off unless your sensor needs it.
            endif

            choice CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_TYPE_$(i)
              prompt "i2c bus type      "
              default CHOICE_ENVIRONMENT_SENSOR_I2C_HARDWARE_$(i)
              help
                Select whether to use a hardware or software i2c bus.

              config CHOICE_ENVIRONMENT_SENSOR_I2C_HARDWARE_$(i)
                bool "Hardware i2c"

              config CHOICE_ENVIRONMENT_SENSOR_I2C_SOFTWARE_$(i)
                bool "Software i2c"
            endchoice

            config PARAM_ENVIRONMENT_SENSOR_I2C_BUS_TYPE_$(i)
              string
              default "software" if CHOICE_ENVIRONMENT_SENSOR_I2C_SOFTWARE_$(i)
              default "hardware"

            if CHOICE_ENVIRONMENT_SENSOR_I2C_HARDWARE_$(i)
              choice CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_$(i)
                prompt "i2c bus name      "
                help
                  Select the hardware i2c bus used by this gate's sensor.
                  Board files offer the buses this board actually routes;
                  "Custom bus name" accepts any Klipper i2c bus name.

                config CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_OTHER_$(i)
                  bool "Custom bus name"
              endchoice

              config PARAM_ENVIRONMENT_SENSOR_I2C_BUS_$(i)
                string "Custom i2c bus name    " if CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_OTHER_$(i)
                default "" if CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_OTHER_$(i)
                help
                  Leave blank to use the MCU's default hardware i2c bus.
            endif

            config PARAM_ENVIRONMENT_SENSOR_I2C_ADDRESS_$(i)
              int "i2c address       "
              default 118 if CHOICE_ENVIRONMENT_SENSOR_TYPE_BME280_$(i)
              default 64  if CHOICE_ENVIRONMENT_SENSOR_TYPE_HTU21D_$(i) || CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7013_$(i) || CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7020_$(i) || CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7021_$(i) || CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT21_$(i)
              default 68  if CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT3X_$(i)
              default 72  if CHOICE_ENVIRONMENT_SENSOR_TYPE_LM75_$(i)
              default 56

            if CHOICE_ENVIRONMENT_SENSOR_I2C_SOFTWARE_$(i)
              config PIN_ENVIRONMENT_SENSOR_SCL_$(i)
                string "SCL pin           "
                validator "$(pin_validator)"
                default ""
                help
                  $(pin_help)

              config PIN_ENVIRONMENT_SENSOR_SDA_$(i)
                string "SDA pin           "
                validator "$(pin_validator)"
                default ""
                help
                  $(pin_help)
            endif
          endif
        endif

        # -------------------------------------
        # Enclosure heater association
        # -------------------------------------

        if MMU_HAS_HEATER && !CUSTOM_HEATER_SETUP
          menuconfig PARAM_FILAMENT_HEATER_GATE_$(i)
            bool "Enclosure heater"
            default y
            help
              Associate an existing Klipper heater with this gate.

          config PARAM_FILAMENT_HEATER_$(i)
            string "Heater name       " if PARAM_FILAMENT_HEATER_GATE_$(i)
            default "$(UNIT_NAME)_heater$(i)"
            help
              Full or short name of the heater for this gate.
        endif

        # -------------------------------------
        # Happy Hare managed fan
        # -------------------------------------

        if MMU_HAS_FANS && !CUSTOM_FAN_SETUP
          config PARAM_FAN_GATE_$(i)
            bool "Managed cooling fan"
            default y
            help
              Create a [fan_generic] managed by Happy Hare for this gate.

          if PARAM_FAN_GATE_$(i)
            menu "Fan h/w config"
              help
                Configure the managed fan output for this gate.

              config PARAM_FAN_MAX_POWER_$(i)
                float "Fan maximum power  "
                default 1.0
                range 0.1 1.0
                help
                  Maximum power setting for this gate's fan (0.1 to 1.0).

              config PARAM_FAN_KICK_START_TIME_$(i)
                float "Fan kick start time"
                default 0.5
                range 0 3.0
                help
                  Time in seconds to run this gate's fan at full power before
                  resetting to its target speed.

              config PIN_FAN_$(i)
                string "Fan pin            "
                validator "$(pin_validator)"
                help
                  Leave blank if this gate does not have a managed fan installed.

            endmenu
          endif
        endif

        # -------------------------------------
        # Fixed heater fan
        # -------------------------------------

        if MMU_HAS_HEATER && !CUSTOM_HEATER_FAN_SETUP
          config PARAM_HEATER_FAN_GATE_$(i)
            bool "Heater fan"
            depends on (!CUSTOM_HEATER_SETUP && PARAM_FILAMENT_HEATER_GATE_$(i)) || (CUSTOM_HEATER_SETUP && PARAM_FILAMENT_HEATER_$(i) != "")
            default y
            help
              Create a fixed [heater_fan] tied directly to this gate's heater.

          if PARAM_HEATER_FAN_GATE_$(i)
            menu "Heater fan h/w config"
              help
                Configure the Klipper heater fan output for this gate.

              config PARAM_HEATER_FAN_MAX_POWER_$(i)
                float "Fan maximum power  "
                default 1.0
                range 0.1 1.0
                help
                  Maximum power setting for this gate's heater fan (0.1 to 1.0).

              config PARAM_HEATER_FAN_KICK_START_TIME_$(i)
                float "Fan kick start time"
                default 0.5
                range 0 3.0
                help
                  Time in seconds to run this gate's heater fan at full power
                  before resetting to its target speed.

              config PARAM_HEATER_FAN_SPEED_$(i)
                float "Fan speed          "
                default 1.0
                range 0.0 1.0
                help
                  Fan speed while this gate's heater is active (0.0 to 1.0).

              config PARAM_HEATER_FAN_SHUTDOWN_SPEED_$(i)
                float "Fan shutdown speed "
                default 1.0
                range 0.0 1.0
                help
                  Fan speed while this gate's MCU is shutting down (0.0 to 1.0).

              config PARAM_HEATER_FAN_HEATER_TEMP_$(i)
                float "Fan heater temp    "
                default 45.0
                range 0 120
                help
                  Temperature (°C) of this gate's heater above which its fan
                  runs, even when the heater is off.

              config PIN_HEATER_FAN_$(i)
                string "Heater fan pin     "
                validator "$(pin_validator)"
                help
                  Leave blank if this gate does not have a heater fan installed.

            endmenu
          endif
        endif

      endmenu
    endif
  @endrepeat@

endif
