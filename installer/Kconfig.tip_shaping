# Defines parameter token types and defaults for tip forming/cutting
#
# Responsible for defining/setting:
#   MMU_HAS_GANTRY_BUMPER_SERVO (and PIN_GANTRY_BUMPER_SERVO)
#   MMU_HAS_SERVO_CUTTER        (and PIN_SERVO_CUTTER_SERVO)
#   PARAM_GANTRY_SERVO_MAXIMUM_ANGLE
#   PARAM_GANTRY_SERVO_MIN_PULSE_WIDTH
#   PARAM_GANTRY_SERVO_MAX_PULSE_WIDTH
#   PARAM_GANTRY_SERVO_INITIAL_ANGLE
#   PARAM_SERVO_CUTTER_MAXIMUM_ANGLE
#   PARAM_SERVO_CUTTER_MIN_PULSE_WIDTH
#   PARAM_SERVO_CUTTER_MAX_PULSE_WIDTH
#
# Responsible for setting:
#   PARAM_FORCE_FORM_TIP_STANDALONE
#   PARAM_SLICER_TIP_PARK_POS
#   PARAM_FORCE_PURGE_STANDALONE
#   PARAM_FORM_TIP_MACRO

config MMU_HAS_GANTRY_BUMPER_SERVO
  def_bool n

config PIN_GANTRY_BUMPER_SERVO
  string
  default ""

# Defaults here, outside any if, so they hold while the prompts are hidden
config PARAM_GANTRY_SERVO_MAXIMUM_ANGLE
  int
  range 1 360
  default 180

config PARAM_GANTRY_SERVO_MIN_PULSE_WIDTH
  float
  default 0.00075

config PARAM_GANTRY_SERVO_MAX_PULSE_WIDTH
  float
  default 0.00225

config PARAM_GANTRY_SERVO_INITIAL_ANGLE
  int
  range 0 360
  default 180

config MMU_HAS_SERVO_CUTTER
  def_bool n

config PIN_SERVO_CUTTER_SERVO
  string
  default ""

config PARAM_SERVO_CUTTER_MAXIMUM_ANGLE
  int
  range 1 360
  default 180

config PARAM_SERVO_CUTTER_MIN_PULSE_WIDTH
  float
  default 0.0005

config PARAM_SERVO_CUTTER_MAX_PULSE_WIDTH
  float
  default 0.0025


menu "Tip Forming / Cutting"
  help
    Tip Shaping

# -------------------------------------
# Servo cutter configuration
# -------------------------------------

  config MMU_HAS_SERVO_CUTTER
    prompt "Have servo cutter at MMU?"
    help
      Enable this if you have a servo based cutter at your MMU

      NOTE: After enabling this be sure to edit Macro variables

  if MMU_HAS_SERVO_CUTTER

    config PIN_SERVO_CUTTER_SERVO
      prompt "Cutting servo pin                  "
      validator "$(pin_validator)"
      help
        $(pin_help)

    config PARAM_SERVO_CUTTER_MAXIMUM_ANGLE
      prompt "Cutting servo h/w max angle        "
      help
        Klipper scales the PWM pulse width to never exceed this angle.
        Set this to 60 for a 60 degree servo

    config PARAM_SERVO_CUTTER_MIN_PULSE_WIDTH
      prompt "Cutting servo min pulse width      "
      help
        Adapt for your servo

    config PARAM_SERVO_CUTTER_MAX_PULSE_WIDTH
      prompt "Cutting servo max pulse width      "
      help
        Adapt for your servo

  endif


# -------------------------------------
# Standalone tip forming choice
# -------------------------------------

  comment "_"
  comment "_Essential tip forming configuration"

  choice CHOICE_FORM_TIP_MACRO
    bool "Select standalone tip shaping option"
    default CHOICE_FORM_TIP_MACRO_CUT_TIP if MMU_HAS_TOOLHEAD_CUTTER
    default CHOICE_FORM_TIP_MACRO_FORM_TIP
    help
      How to perform standalone tip shaping (forming or cutting)

    config CHOICE_FORM_TIP_MACRO_FORM_TIP
      bool "Tip shaping using filament movement"
      help
        Uses repeated retract/extrude operations to shape filament
        tip into a torpedo shape without strings.
        Needs careful tuning.

    config CHOICE_FORM_TIP_MACRO_CUT_TIP
      bool "Tip cutting using toolhead cutter"
      depends on MMU_HAS_TOOLHEAD_CUTTER
      help
        If toolhead contains a filament cutter with activation
        via toolhead movement.

    config CHOICE_FORM_TIP_MACRO_SLICER
      bool "Slicer controlled tip forming"
      help
        Tip forming is controlled and managed by the slicer rather than Happy Hare.

    config CHOICE_FORM_TIP_MACRO_OTHER
      bool "Other / manually entered macro"
      help
        Specify a custom macro to call to perform tip forming / cutting

    config FORM_TIP_MACRO_OTHER
      string "Tip forming/cutting  macro" if CHOICE_FORM_TIP_MACRO_OTHER
      default "-enter-your-macro-"
      help
        Name of macro to call to perform the tip forming or cutting operation.
  endchoice

  config PARAM_FORM_TIP_MACRO
    string
    default "_MMU_FORM_TIP" if CHOICE_FORM_TIP_MACRO_FORM_TIP
    default "_MMU_CUT_TIP" if CHOICE_FORM_TIP_MACRO_CUT_TIP
    default ""                if CHOICE_FORM_TIP_MACRO_SLICER
    default FORM_TIP_MACRO_OTHER if CHOICE_FORM_TIP_MACRO_OTHER
    default ""


# -------------------------------------
# Toolhead cutter configuration
# -------------------------------------

  if CHOICE_FORM_TIP_MACRO_CUT_TIP

    config MMU_HAS_GANTRY_BUMPER_SERVO
      prompt "Have servo operated gantry bumper?"
      default n

    config PIN_GANTRY_BUMPER_SERVO
      prompt "Gantry servo pin" if MMU_HAS_GANTRY_BUMPER_SERVO
      validator "$(pin_validator)"
      help
        Optional. Used to deploy fold-down "bumper" for tip cutting
        when using a toolhead mounted filament cutting blade

    if MMU_HAS_GANTRY_BUMPER_SERVO
      config PARAM_GANTRY_SERVO_MAXIMUM_ANGLE
        prompt "Gantry servo h/w max angle         "
        help
          Klipper scales the PWM pulse width to never exceed this angle

      config PARAM_GANTRY_SERVO_MIN_PULSE_WIDTH
        prompt "Gantry servo min pulse width       "

      config PARAM_GANTRY_SERVO_MAX_PULSE_WIDTH
        prompt "Gantry servo max pulse width       "

      config PARAM_GANTRY_SERVO_INITIAL_ANGLE
        prompt "Gantry servo initial angle         "
        help
          Angle set at Klipper startup. Normally the retracted position:
          match "Gantry servo up angle" under
          Macro Variables -> Toolhead tip cutting
    endif
  endif


# -------------------------------------
# Other tip shaping options
# -------------------------------------

  config PARAM_FORCE_FORM_TIP_STANDALONE
    boolint "Happy Hare controlled in-print tip forming/cutting"
    default 0 if CHOICE_FORM_TIP_MACRO_SLICER
    default 1
    help
      You can choose whether you want the slicer or Happy Hare (recommended) to control tip forming.
      To use tip cutting ensure this selection is checked and be sure to turn off in your slicer
  config PARAM_SLICER_TIP_PARK_POS
    string
    default "0"
  config PARAM_SLICER_TIP_PARK_POS
    prompt "Slicer tip park pos"
    depends on !PARAM_FORCE_FORM_TIP_STANDALONE
    help
      This specifies the position of filament in extruder after slicer completes tip forming
      and is usually a setting in the slicer config.
      (It is necessary to help Happy Hare complete the extruder unloading process)

  config PARAM_EXTRUDER_FORM_TIP_CURRENT
    int "Extruder tip forming current"
    default 100
    help
      % of extruder current (100%-150%) to use when forming tip (100 to disable feature)

endmenu
