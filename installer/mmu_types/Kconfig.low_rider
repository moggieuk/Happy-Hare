config MMU_TYPE_LOW_RIDER_1_0
  bool "Low Rider"
  help
    This is a fork/variation of the great MMX design and uses 2-6 cams
    to select gates/lanes with a servo motor.
  select SERVO_SELECTOR
  imply  MMU_HAS_SENSOR_EXTRUDER
  select MMU_HAS_LEDS
  imply  PARAM_FILAMENT_ALWAYS_GRIPPED
  imply  PARAM_VARIABLE_ROTATION_DISTANCES

if MMU_TYPE_LOW_RIDER_1_0

  source "Kconfig.num_gates"
  source "servos/Kconfig"

  if SHOW_MMU_ADDITIONS_WITH_TYPE
    source "Kconfig.mmu_additions"
  endif

  source "Kconfig.capabilities"


  # -------------------------------------
  # Defaults
  # -------------------------------------

  # Identity -------------------------------
  config PARAM_VENDOR
    default "LowRider"
  config PARAM_VERSION
    default "1.0"
  config PARAM_NUM_GATES
    default 6

  # Gear stepper ---------------------------
  config PARAM_GEAR_ROTATION_DISTANCE
    default 23
  config PARAM_GEAR_GEAR_RATIO
    default "80:20"
  config PARAM_GEAR_FULL_STEPS_PER_ROTATION
    default 200
  config PARAM_GEAR_RUN_CURRENT
    default 0.7
  config PARAM_GEAR_HOLD_CURRENT
    default 0.1

  # Selector servo control -----------------
  choice CHOICE_SERVO_TYPE
    default SERVO_TYPE_DM996
  endchoice

  config PARAM_SERVO_DURATION
    default 0.6
  config PARAM_SERVO_DWELL
    default 1.0
  config PARAM_SERVO_ALWAYS_ACTIVE
    default 0
  config PARAM_SERVO_BYPASS_ANGLE
    default -1
  config PARAM_SERVO_RELEASE_ANGLE
    default 0
  config PARAM_SERVO_MAX_ANGLE
    default 180
  # Reserve 0 degrees for the release position, then distribute gates evenly
  # over the remaining selector travel up to 180 degrees.
  config PARAM_SERVO_GATE_ANGLES
    default "90, 180"                       if PARAM_NUM_GATES = 2
    default "60, 120, 180"                  if PARAM_NUM_GATES = 3
    default "45, 90, 135, 180"              if PARAM_NUM_GATES = 4
    default "36, 72, 108, 144, 180"         if PARAM_NUM_GATES = 5
    default "30, 60, 90, 120, 150, 180"     if PARAM_NUM_GATES = 6

  # Gate endstops and homing ---------------
  config PARAM_GATE_PARKING_DISTANCE
    default -25
  config PARAM_GATE_HOMING_MAX
    default 1000

  comment "_"

endif
