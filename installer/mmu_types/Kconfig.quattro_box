config MMU_FAMILY_QUATTRO_BOX
  bool "QuattroBox"
  help
    QuattroBox is type-B MMU with 4 gates. It uses a Filamentalist based
    design for spool respooling leveraging gear steppers for motion.
    Has integrated encoder for measurement of filament movement.
    Has eject button option -- be sure to install eject button addon.
  select VIRTUAL_SELECTOR
  select MMU_HAS_ENCODER
  select PARAM_VARIABLE_ROTATION_DISTANCES
  select PARAM_VARIABLE_BOWDEN_LENGTHS
  select PARAM_FILAMENT_ALWAYS_GRIPPED
  imply BOOL_ENABLE_LEDS
  imply MMU_HAS_EJECT_BUTTONS


if MMU_FAMILY_QUATTRO_BOX
  choice
    prompt "Version"

    config MMU_TYPE_QUATTRO_BOX_1_0
      bool "QuattroBox v1.0"
      select MMU_HAS_LEDS
      select PARAM_SYNC_TO_EXTRUDER
      select PARAM_SYNC_FORM_TIP
      select PARAM_SYNC_PURGE

      config MMU_TYPE_QUATTRO_BOX_1_1
      bool "QuattroBox v1.1"
      select MMU_HAS_LEDS
      select PARAM_SYNC_TO_EXTRUDER
      select PARAM_SYNC_FORM_TIP
      select PARAM_SYNC_PURGE
      help
        Version 1.1 has updated LEDs.

      config MMU_TYPE_QUATTRO_BOX_2_0
      bool "QuattroBox v2"
      select MMU_HAS_LEDS
      select PARAM_SYNC_TO_EXTRUDER
      select PARAM_SYNC_FORM_TIP
      select PARAM_SYNC_PURGE
      # The Chameleon X5 supplies the defaults for these
      imply MMU_HAS_ENVIRONMENT_SENSOR         if BOARD_TYPE_CHAMELEON_X5_1_0
      imply MMU_HAS_HEATER                     if BOARD_TYPE_CHAMELEON_X5_1_0
      imply MMU_HAS_FANS                       if BOARD_TYPE_CHAMELEON_X5_1_0
      imply MMU_HAS_SENSOR_ENTRY               if BOARD_TYPE_CHAMELEON_X5_1_0
      imply MMU_HAS_SENSOR_EXIT                if BOARD_TYPE_CHAMELEON_X5_1_0
      imply MMU_HAS_SENSOR_SHARED_EXIT         if BOARD_TYPE_CHAMELEON_X5_1_0
      imply MMU_HAS_SYNC_FEEDBACK_BUFFER       if BOARD_TYPE_CHAMELEON_X5_1_0
      imply MMU_HAS_SENSOR_BUFFER_PROPORTIONAL if BOARD_TYPE_CHAMELEON_X5_1_0 && !MMU_SHARED_SYNC_FEEDBACK_BUFFER
      # Home gates to the shared exit sensor whenever one is fitted
      imply PREFERS_CHOICE_GATE_HOMING_ENDSTOP_SHARED_EXIT
      help
        All new version 2 design with heated environment.

    endchoice

  source "Kconfig.capabilities"

  # -------------------------------------
  # Defaults
  # -------------------------------------

  config PARAM_VENDOR
    default "QuattroBox"
  config PARAM_NUM_GATES
    default 4

  config PARAM_GATE_HOMING_MAX
    default 200
  config PARAM_GATE_PRELOAD_HOMING_MAX
    default 200
  config PARAM_GATE_PARKING_DISTANCE
    default -30
  config PARAM_GATE_FINAL_EJECT_DISTANCE
    default 200


  if MMU_TYPE_QUATTRO_BOX_1_0
    config PARAM_VERSION
      default "1.0"

    config PARAM_GEAR_GEAR_RATIO
      default "50:17"
    config PARAM_GEAR_RUN_CURRENT
      default 1.27
    config PARAM_GEAR_HOLD_CURRENT
      default 0.2
    config PARAM_GEAR_HOMING_SPEED
      default 80

    config PARAM_GATE_ENDSTOP_TO_ENCODER
      default 18

    config PARAM_CHAIN_COUNT
      default 32
    config PARAM_COLOR_ORDER
      default "GRBW,GRBW,GRBW,GRBW,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB"
    config PARAM_EXIT_LEDS
      default "neopixel:_$(UNIT_NAME)_leds (1-4)"
    config PARAM_STATUS_LEDS
      default "neopixel:_$(UNIT_NAME)_leds (5-14)"
    config PARAM_LOGO_LEDS
      default "neopixel:_$(UNIT_NAME)_leds (15-32)"

    comment "_"
  endif


  if MMU_TYPE_QUATTRO_BOX_1_1
    config PARAM_VERSION
      default "1.1"

    config PARAM_GEAR_GEAR_RATIO
      default "50:17"
    config PARAM_GEAR_RUN_CURRENT
      default 1.27
    config PARAM_GEAR_HOLD_CURRENT
      default 0.2
    config PARAM_GEAR_HOMING_SPEED
      default 80

    config PARAM_GATE_ENDSTOP_TO_ENCODER
      default 18

    config PARAM_CHAIN_COUNT
      default 36
    config PARAM_COLOR_ORDER
      default "GRBW,GRBW,GRBW,GRBW,GRBW,GRBW,GRBW,GRBW,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB"
    config PARAM_EXIT_LEDS
      default "neopixel:_$(UNIT_NAME)_leds (2,4,6,8)"
    config PARAM_STATUS_LEDS
      default "neopixel:_$(UNIT_NAME)_leds (1,3,5,7)"
    config PARAM_LOGO_LEDS
      default "neopixel:_$(UNIT_NAME)_leds (9-36)"

    comment "_"
  endif


  # -------------------------------------
  # Latest v2 QuattroBox
  # -------------------------------------

  if MMU_TYPE_QUATTRO_BOX_2_0
    config PARAM_VERSION
      default "2.0"

    # v2 has custom mcu board
    choice BOARD_TYPE
      default BOARD_TYPE_CHAMELEON_X5_1_0
    endchoice

    # Heater: the Chameleon X5 board file supplies it as misc hardware
    config CUSTOM_HEATER_SETUP
      def_bool y if BOARD_TYPE_CHAMELEON_X5_1_0 && !MMU_HAS_PER_GATE_CONFIG
    config PARAM_FILAMENT_HEATER
      default "$(UNIT_NAME)_heater" if CUSTOM_HEATER_SETUP
    config PARAM_HEATER_FAN_HEATER_TEMP
      default 40.0
    config PARAM_HEATER_FAN_SHUTDOWN_SPEED
      default 0.0

    # Chamber sensor
    config PARAM_ENVIRONMENT_SENSOR
      default "$(UNIT_NAME)_Chamber"
    choice CHOICE_ENVIRONMENT_SENSOR_TYPE
      default CHOICE_ENVIRONMENT_SENSOR_TYPE_BME280
    endchoice

    config PARAM_GEAR_GEAR_RATIO
      default "1:1"
    config PARAM_GEAR_RUN_CURRENT
      default 0.9
    config PARAM_GEAR_HOLD_CURRENT
      default 0.2
    config PARAM_SYNC_GEAR_CURRENT
      default 40

    config PARAM_GEAR_LOAD_SPEED
      default 500
    config PARAM_GEAR_LOAD_ACCEL
      default 500
    config PARAM_GEAR_UNLOAD_SPEED
      default 500
    config PARAM_GEAR_UNLOAD_ACCEL
      default 500
    config PARAM_GEAR_SHORT_MOVE_ACCEL
      default 600
    config PARAM_GEAR_HOMING_SPEED
      default 50

    config PARAM_GATE_ENDSTOP_TO_ENCODER
      default 0
    config PARAM_BOWDEN_UNLOAD_HOMING_BUFFER
      default 50
    config PARAM_GATE_PRELOAD_PARKING_DISTANCE
      default 10 if CHOICE_GATE_PRELOAD_ENDSTOP_EXIT
    config PARAM_GATE_PRELOAD_ATTEMPTS
      default 5 if !CHOICE_GATE_PRELOAD_ENDSTOP_NONE

    config PARAM_CHAIN_COUNT
      default 38
    config PARAM_COLOR_ORDER
      default "GRBW,GRBW,GRBW,GRBW,GRBW,GRBW,GRBW,GRBW,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB"
    config PARAM_EXIT_LEDS
      default "neopixel:_$(UNIT_NAME)_leds (1-4)"
    config PARAM_ENTRY_LEDS
      default "neopixel:_$(UNIT_NAME)_leds (8-5)"
    config PARAM_STATUS_LEDS
      default "neopixel:_$(UNIT_NAME)_leds (9-38)"
    config PARAM_LOGO_LEDS
      default ""
    choice CHOICE_ENTRY_EFFECT
      default CHOICE_ENTRY_EFFECT_GATE_STATUS
    endchoice

    comment "_"
  endif

endif # MMU_FAMILY_QUATTRO_BOX
