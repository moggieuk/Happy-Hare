config MMU_TYPE_QIDI_BOX_1_0
  bool "QIDI Box"
  help
    QIDI Box is a four-gate type-B MMU with one always-engaged gear
    motor per gate, a shared hub sensor, pre-gate sensors, a tension
    feedback buffer, and a built-in filament dryer. The stock stepper
    drivers are configured in hardware rather than through TMC UART.
  select VIRTUAL_SELECTOR
  select MMU_HAS_SENSOR_ENTRY
  select MMU_HAS_SENSOR_SHARED_EXIT
  select MMU_HAS_SENSOR_EXTRUDER
  select MMU_HAS_SYNC_FEEDBACK_BUFFER
  select MMU_HAS_SENSOR_BUFFER_TENSION
  select UNSELECT_MMU_HAS_SENSOR_BUFFER_COMPRESSION
  select UNSELECT_MMU_HAS_SENSOR_BUFFER_PROPORTIONAL
  imply  MMU_HAS_ENVIRONMENT_SENSOR
  imply  MMU_HAS_HEATER
  select PARAM_FILAMENT_ALWAYS_GRIPPED
  select MMU_GEAR_ROTATES_SPOOL           # Gate gear motor turns the spool
  select MMU_HAS_NFC_READER
  select MMU_HAS_PER_GATE_NFC_READERS
  select PARAM_SYNC_TO_EXTRUDER
  select PARAM_SYNC_FORM_TIP
  select PARAM_SYNC_PURGE
  select DISABLE_NUM_GATES_OPTION

if MMU_TYPE_QIDI_BOX_1_0

  # The readers are declared by the board profile, one physical chip per pair
  # of gates, so the per-gate list repeats each name twice.
  config CUSTOM_NFC_READER_SETUP
    def_bool y
  config PARAM_NFC_READER_0
    default "$(UNIT_NAME)_nfc01"
  config PARAM_NFC_READER_1
    default "$(UNIT_NAME)_nfc01"
  config PARAM_NFC_READER_2
    default "$(UNIT_NAME)_nfc23"
  config PARAM_NFC_READER_3
    default "$(UNIT_NAME)_nfc23"

  # The tag sits on the spool, so the gear motor has to turn it past the
  # antenna to find it; a full turn of a near-empty spool is about 480mm.
  # Retracting is the safe direction here - the gate parks at the shared hub,
  # so feeding forward would push filament into it.
  config PARAM_NFC_GATE_JOG_SCAN_WINDOW
    default "-480, 60"
  config PARAM_NFC_PRELOAD_JOG_SCAN_WINDOW
    default "-480, 60"
  config PARAM_NFC_GATE_CLEAR_DISTANCE
    default -70
  config PARAM_NFC_PRELOAD_CLEAR_DISTANCE
    default -70

  # One physical reader serves two gates, so a neighbor's spool can sit in
  # the same RF field and be attributed to the wrong gate.
  config PARAM_NFC_NEIGHBOR_CHECK
    default y

  # Motor current and driver mode are configured in hardware. Default to no
  # Klipper-managed TMC, while allowing modified units to select one normally.
  choice CHOICE_GEAR_TMC
    default CHOICE_GEAR_TMC_NONE
  endchoice

  choice CHOICE_BUFFER_SPRING_STATE
    default CHOICE_BUFFER_SPRING_STATE_TENSION
  endchoice

  # There are no per-gate exit sensors, so preload homes to the shared hub
  # endstop (inherited from gate_homing_endstop) and then parks back by
  # gate_parking_distance, which leaves the filament before the hub, inside
  # the gate's own path. A fixed move cannot do this: the parking retract is
  # not applied when the preload endstop is 'none'.

  if SHOW_MMU_ADDITIONS_WITH_TYPE
    source "Kconfig.mmu_additions"
  endif

  source "Kconfig.capabilities"


  # ----------------------------------------
  # Defaults
  # ----------------------------------------

  config PARAM_VENDOR
    default "QIDI"
  config PARAM_VERSION
    default "1.0"
  config PARAM_NUM_GATES
    default 4
  choice BOARD_TYPE
    default BOARD_TYPE_QIDI_BOX_2_0
  endchoice
  choice CHOICE_TOOLHEAD_TYPE
    default TOOLHEAD_TYPE_QIDI_Q2
  endchoice

  # Gear stepper ---------------------------
  config PARAM_GEAR_GEAR_RATIO
    default "1:1"
  config PARAM_GEAR_ROTATION_DISTANCE
    default 13.6
  config PARAM_GEAR_MICROSTEPS
    default 16

  # Q2 toolhead cutter --------------------
  if MMU_HAS_TOOLHEAD_CUTTER && TOOLHEAD_TYPE_QIDI_Q2
    config VAR_CUT_TIP_PIN_LOC_XY
      default "15, 0.5"
    config VAR_CUT_TIP_PIN_LOC_COMPRESSED_XY
      default "-0.5, 0.5"
    config VAR_CUT_TIP_RETRACT_LENGTH
      default 15
    config BOOL_CUT_TIP_SIMPLE_TIP_FORMING
      default n
    config VAR_CUT_TIP_PUSHBACK_LENGTH
      default 0
  endif

  # Speeds ---------------------------------
  config PARAM_GEAR_LOAD_SPEED
    default 120
  config PARAM_GEAR_SHORT_MOVE_SPEED
    default 80
  config PARAM_EXTRUDER_LOAD_SPEED
    default 16
  config PARAM_EXTRUDER_UNLOAD_SPEED
    default 16

  # Gate endstops and homing ---------------
  config PARAM_GATE_HOMING_MAX
    default 1500
  config PARAM_GATE_PRELOAD_HOMING_MAX
    default 1500
  config PARAM_GATE_PARKING_DISTANCE
    default -80
  config PARAM_GATE_FINAL_EJECT_DISTANCE
    default 1500

  # Buffer ---------------------------------
  config PARAM_BUFFER_RANGE
    default 8
  config PARAM_BUFFER_MAXRANGE
    default 12

  # Dryer ----------------------------------
  # The profile implies MMU_HAS_HEATER, so name the heater object the same way
  # the other vendors with a dryer do (see Kconfig.vvd / Kconfig.kms). Without
  # a name the dryer is enabled but bound to nothing and silently does nothing.
  config PARAM_FILAMENT_HEATER
    default "$(UNIT_NAME)_heater"

  comment "_"

endif
