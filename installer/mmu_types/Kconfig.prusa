config MMU_TYPE_PRUSA_MMU3_3_0
  bool "Prusa MMU3"
  select LINEAR_IDLER_SELECTOR
  select MMU_HAS_SENSOR_SHARED_EXIT
  select UNSELECT_MMU_HAS_LEDS        # MMU3 LEDs are on the SHR16 shift register (custom setup)
  select UNSELECT_MMU_HAS_ENCODER
  select UNSELECT_MMU_HAS_ESPOOLER
  select UNSELECT_MMU_HAS_FILAMENT_BUFFER
  select UNSELECT_CREATE_MCU_ENVIRONMENT_SENSORS  # ATmega32U4 has no MCU temperature sensor

  select BOOL_REQUIRE_BOWDEN_MOVE
  select UNSELECT_VARIABLE_BOWDEN_LENGTHS # Disable
  select UNSELECT_FILAMENT_ALWAYS_GRIPPED # Disable
  select UNSELECT_MMU_HAS_BYPASS          # No bypass gate

  select DISABLE_NUM_GATES_OPTION

if MMU_TYPE_PRUSA_MMU3_3_0

  config PARAM_VENDOR
    default "Prusa"
  config PARAM_VERSION
    default "3.0"
  config PARAM_NUM_GATES
    default 5

  choice BOARD_TYPE
    default BOARD_TYPE_PRUSA_MMU3_1_0
  endchoice

  # The MMU3 has three fixed TMC2130s on the hardware SPI bus
  config PARAM_GEAR_TMC
    default "tmc2130"
  config PARAM_SELECTOR_TMC
    default "tmc2130"
  config PARAM_GEAR_SPI_BUS
    default "spi"
  config PARAM_SELECTOR_SPI_BUS
    default "spi"
  config PARAM_IDLER_SPI_BUS
    default "spi"

  # ------------------------------------------------------------------
  # Defaults (gear/selector/idler motion hardware)
  # Values are those tuned on the reference MMU3 (Freakazo's mk3s):
  #   - selector/idler run in spreadCycle above ~3mm/s (stealthchop_threshold
  #     3) so tmc2130 StallGuard works during homing while the motors sit
  #     silently in stealthChop at standstill -- stealthChop disables stall
  #     detection so the threshold must stay below the slowest homing
  #     (selector second homing approach runs at 8/2=4mm/s)
  #   - SGT: selector 15, idler 0
  #   - gear freewheels when disabled (driver_FREEWHEEL 1)
  # NOTE: rotation distances are calibration-dependent on the MMU3 and
  # should be tuned for your unit with MMU_CALIBRATE_GEAR / selector
  # calibration routines
  # ------------------------------------------------------------------

  config PARAM_GEAR_GEAR_RATIO
    default "1:1"
  config PARAM_GEAR_ROTATION_DISTANCE
    default 19.394
  config PARAM_GEAR_RUN_CURRENT
    default 0.5
  config PARAM_GEAR_HOLD_CURRENT
    default 0.01
  config PARAM_GEAR_MICROSTEPS
    default 16
  config PARAM_GEAR_STEALTHCHOP
    default 999999		# No gear stallguard homing on MMU3 -- always stealthChop
  config PARAM_GEAR_SGT
    default 0
  config PARAM_GEAR_FREEWHEEL
    default 1
  config PARAM_GEAR_HOMING_SPEED
    default 30

  config PARAM_SELECTOR_GEAR_RATIO
    default "1:1"
  config PARAM_SELECTOR_ROTATION_DISTANCE
    default 8
  config PARAM_SELECTOR_RUN_CURRENT
    default 0.8
  config PARAM_SELECTOR_HOLD_CURRENT
    default 0.3
  config PARAM_SELECTOR_MICROSTEPS
    default 8
  config PARAM_SELECTOR_STEALTHCHOP
    default 3		# stealthChop below 3mm/s (quiet standstill); spreadCycle above so StallGuard homing works
  config PARAM_SELECTOR_SGT
    default 15
  config PARAM_SELECTOR_ACCEL
    default 1200
  config PARAM_SELECTOR_HOMING_SPEED
    default 8
    help
      StallGuard only detects stalls at medium motor speeds. At 8mm/s and an
      8mm rotation distance the selector runs ~60RPM -- well within range.
      Faster speeds (60mm/s = ~450RPM) push the back-EMF too high and the
      stall is never detected (verified on the live MMU3).
      stealthchop_threshold must stay below the second homing approach speed
      (homing_speed/2 = 4mm/s) or the approach runs in stealthChop and the
      stall is never detected.

  config PARAM_SELECTOR_MOVE_SPEED
    default 20
    help
      Slow, quiet gate selection moves. The 200mm/s generic default is too
      fast for the MMU3's ATmega32U4: the step command pressure combined
      with the shift register bitbang burst overflowed the MCU move queue
      ("Move queue overflow" -- verified on the live MMU3).

  config PARAM_IDLER_GEAR_RATIO
    default "1:1"
  config PARAM_IDLER_ROTATION_DISTANCE
    default 40
    help
      The idler is a rotating barrel driven 1:1 by the motor through a
      metal coupler. The generic 128 placeholder made the 40mm homing
      search only 12.5mm of real travel so the stop was never reached.
      Verified working at 40 on the live MMU3 (matches the original
      pre-port config value).
  config PARAM_IDLER_RUN_CURRENT
    default 0.8
  config PARAM_IDLER_HOLD_CURRENT
    default 0.1
  config PARAM_IDLER_MICROSTEPS
    default 16
    help
      The pre-port config used 16 microsteps and the idler offsets
      (mmu_idler_offsets) are in those units. At 8 the barrel travels
      twice as far per commanded mm, so homing "found" the stop after a
      fraction of the expected travel and the stored offsets would land
      2x too far.
  config PARAM_IDLER_STEALTHCHOP
    default 3		# stealthChop below 3mm/s (quiet standstill); spreadCycle above so StallGuard homing works
  config PARAM_IDLER_SGT
    default 12
    help
      StallGuard2 threshold for the light idler barrel. The stock 60 (and
      15) never trip at the silicone stop, while 0 and below false-trigger
      on free motion ("Homed" instantly with no travel). 6 still
      false-triggered on the acceleration transient at homing start; 14
      never trips. 10-12 trip exactly at the stop after full travel
      (verified on the live MMU3).

  config CUSTOM_LED_SETUP
    def_bool y

  if SHOW_MMU_ADDITIONS_WITH_TYPE
    source "Kconfig.mmu_additions"
  endif

  source "Kconfig.capabilities"

endif
