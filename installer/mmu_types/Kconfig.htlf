config MMU_TYPE_HTLF_1_0
  bool "HTLF"
  help
    HappyTurtleLettuceFeeder (HTLF) is a 4 gate type-A MMU with
    rotary cam based selection mechanism controlled by stepper
  select ROTARY_SELECTOR
  select MMU_HAS_LEDS
  select PARAM_FILAMENT_ALWAYS_GRIPPED
  select PARAM_VARIABLE_ROTATION_DISTANCES


if MMU_TYPE_HTLF_1_0

  choice CHOICE_HTLF_CAM_ANGLE
    prompt "Cam lobe angle"
    default CHOICE_HTLF_CAM_ANGLE_60
    help
      The lobe angle of the printed cam. It sets the selector
      position of each gate (60 is the recommended print)

    config CHOICE_HTLF_CAM_ANGLE_30
      bool "30 degrees"
    config CHOICE_HTLF_CAM_ANGLE_45
      bool "45 degrees"
    config CHOICE_HTLF_CAM_ANGLE_60
      bool "60 degrees"

  endchoice

  # Selector rotation_distance is 360 so selector "mm" are cam degrees. Gate 0's lobe
  # engages 215 degrees from home and each later gate one cam angle closer
  config PARAM_CAD_GATE0_POS
    default "215"
  config PARAM_CAD_GATE_WIDTH
    default "-30" if CHOICE_HTLF_CAM_ANGLE_30
    default "-45" if CHOICE_HTLF_CAM_ANGLE_45
    default "-60"
  config PARAM_CAD_SELECTOR_TOLERANCE
    default "30" if CHOICE_HTLF_CAM_ANGLE_30
    default "45" if CHOICE_HTLF_CAM_ANGLE_45
    default "60"


  source "Kconfig.capabilities"

  config PARAM_VENDOR
    default "HTLF"
  config PARAM_VERSION
    default "1.0"

  config PARAM_NUM_GATES
    default 4
  config PARAM_DESIGN_NUM_GATES
    default 4

  # ----------------------------------------
  # Defaults
  # ----------------------------------------

  # Gear stepper ---------------------------
  config PARAM_GEAR_GEAR_RATIO
    default "1:1"
  config PARAM_GEAR_ROTATION_DISTANCE
    default 4.65
  config PARAM_GEAR_RUN_CURRENT
    default 0.8
  config PARAM_GEAR_HOLD_CURRENT
    default 0.1
  config PARAM_GEAR_MICROSTEPS
    default 16

  # Selector stepper -----------------------
  config PARAM_SELECTOR_GEAR_RATIO
    default "1:1"
  config PARAM_SELECTOR_ROTATION_DISTANCE
    default 360
  config PARAM_SELECTOR_RUN_CURRENT
    default 0.6
  config PARAM_SELECTOR_HOLD_CURRENT
    default 0.3

  config PARAM_SELECTOR_RELEASE_GATES
    default "1, 2, 3, 0"

  # Speeds ---------------------------------
  config PARAM_GEAR_LOAD_SPEED
    default 135
  config PARAM_GEAR_SHORT_MOVE_SPEED
    default 80
  config PARAM_SELECTOR_MOVE_SPEED
    default 562.5
  config PARAM_SELECTOR_HOMING_SPEED
    default 675
  config PARAM_SELECTOR_ACCEL
    default 562.5
  config PARAM_EXTRUDER_LOAD_SPEED
    default 16

  # Gate endstops and homing ---------------
  config PARAM_GATE_PARKING_DISTANCE
    default -25
  config PARAM_GATE_HOMING_MAX
    default 1000

  comment "_"

endif 
