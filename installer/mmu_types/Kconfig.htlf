config MMU_TYPE_HTLF_1_0
  bool "HTLF"
  help
    HappyTurtleLettuceFeeder (HTLF) is a 4 gate type-A MMU with
    rotary cam based selection mechanism controlled by stepper
  select ROTARY_SELECTOR
  select MMU_HAS_LEDS
  imply  PARAM_REQUIRE_BOWDEN_MOVE
  select PARAM_FILAMENT_ALWAYS_GRIPPED
  select PARAM_VARIABLE_ROTATION_DISTANCES
  select DISABLE_NUM_GATES_OPTION

####################
##### Defaults #####
####################

if MMU_TYPE_HTLF_1_0

  if SHOW_MMU_ADDITIONS_WITH_TYPE
    source "Kconfig.mmu_additions"
  endif

  source "Kconfig.capabilities"

  config PARAM_VENDOR
    default "HTLF"
  config PARAM_VERSION
    default "1.0"
  config PARAM_NUM_GATES
    default 4

  config PARAM_GEAR_GEAR_RATIO
    default "80:20"
  config PARAM_GEAR_RUN_CURRENT
    default 0.7
  config PARAM_GEAR_HOLD_CURRENT
    default 0.1

  config PARAM_GATE_PARKING_DISTANCE
    default -25
  config PARAM_GATE_HOMING_MAX
    default 1000

  config PARAM_SELECTOR_RELEASE_GATES
    default "1, 2, 3, 0"

  comment "_"

endif 
