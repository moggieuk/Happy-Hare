# Environment sensors(s)
#
# Responsible for setting:
#   MMU_HAS_ENVIRONMENT_SENSOR
#   MMU_HAS_PER_GATE_CONFIG
#
# Single MCU:
#   PARAM_ENVIRONMENT_SENSOR_TYPE
#   PARAM_SENSOR_REPORT_TIME_PARAM
#   PARAM_ENVIRONMENT_SENSOR_REPORT_TIME
#   PARAM_ENVIRONMENT_SENSOR_I2C_ADDRESS
#
#   CHOICE_ENVIRONMENT_SENSOR_I2C_HARDWARE (i2c bus type)
#     PARAM_ENVIRONMENT_SENSOR_I2C_BUS
#
#   CHOICE_ENVIRONMENT_SENSOR_I2C_SOFTWARE (i2c bus type)
#     PIN_ENVIRONMENT_SENSOR_SCL
#     PIN_ENVIRONMENT_SENSOR_SDA
#
# Per-gate:
#   as above with _<gate_index> extension
#
# SUPPORTED SENSOR TYPES
#   - AHT10     (humidity/temperature, legacy name known to every Klipper/Kalico)
#   - AHT1X     (humidity/temperature, Klipper after v0.13.0 or Kalico v2026.06+)
#   - AHT2X     (humidity/temperature, Klipper after v0.13.0 or Kalico v2026.06+)
#   - AHT3X     (humidity/temperature, Klipper after v0.13.0 or Kalico v2026.06+)
#   - BME280    (humidity/temperature/pressure; also BMP180/BMP280/BMP388/BME680)
#   - HTU21D    (humidity/temperature)
#   - SI7013, SI7020, SI7021, SHT21 (humidity/temperature, HTU21D family)
#   - SHT3X     (humidity/temperature, SHT30/SHT31/SHT35)
#   - LM75      (temperature only)
#
# SUPPORTED I2C HARDWARE BUS OPTIONS:
#   - i2c2_PB10_PB11  (default)
#   - i2c3_PB3_PB4    (alternative)
#
# Can be disabled and forced off with:
#   select UNSELECT_MMU_HAS_ENVIRONMENT_SENSOR


comment "_"
comment "_Environment Sensors"

config UNSELECT_MMU_HAS_ENVIRONMENT_SENSOR
  def_bool n

if !UNSELECT_MMU_HAS_ENVIRONMENT_SENSOR
  config MMU_HAS_ENVIRONMENT_SENSOR
    bool "Has environment sensor(s)?"
    forceshow
    default n
    help
      Select if the MMU has a humidity/temperature sensor in the filament storage enclosure
endif
comment "$(misc_hardware_hint)" if MMU_HAS_ENVIRONMENT_SENSOR && CUSTOM_ENVIRONMENT_SENSOR_SETUP


# -------------------------------------
# Environment/temperature sensor config
# -------------------------------------

if MMU_HAS_ENVIRONMENT_SENSOR && !CUSTOM_ENVIRONMENT_SENSOR_SETUP && !MMU_HAS_PER_GATE_CONFIG
  menu "Environment sensor h/w config"
    help
      Configure the shared enclosure temperature and humidity sensor.

    config PARAM_ENVIRONMENT_SENSOR
      string "Sensor name       "
      default "$(UNIT_NAME)_Env"
      help
        Name of the environment sensor section in the printer config
        E.g., "temperature_sensor MMU_enclosure" or just "MMU_enclosure"


    # -------------------------------------
    # Single MCU: all settings on one page
    # -------------------------------------

      choice CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_TYPE
        prompt "i2c bus type      "
        default CHOICE_ENVIRONMENT_SENSOR_I2C_HARDWARE
        help
          Select whether to use hardware or software i2c bus for the sensor

        config CHOICE_ENVIRONMENT_SENSOR_I2C_HARDWARE
          bool "Hardware i2c"
          help
            Use hardware i2c bus (faster, recommended)

        config CHOICE_ENVIRONMENT_SENSOR_I2C_SOFTWARE
          bool "Software i2c"
          help
            Use software i2c bus
      endchoice

      choice CHOICE_ENVIRONMENT_SENSOR_TYPE
        prompt "Sensor type       "
        default CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT2X
        help
          Select the type of environment sensor being used
          AHT1X/AHT2X/AHT3X need Klipper newer than v0.13.0 or Kalico v2026.06+
          Use AHT10 on older firmware

        config CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT10
          bool "AHT10 [[DIM]]/ older Klipper[[/DIM]]"
          help
            AHT10/AHT20/AHT21 on Klipper v0.13.0 or older or Kalico before v2026.06.
            Newer firmware treats AHT10 as AHT1X, so choose AHT2X/AHT3X there.

        config CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT1X
          bool "AHT1X"
          help
            AHT1X humidity/temperature sensor

        config CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT2X
          bool "AHT2X"
          help
            AHT2X humidity/temperature sensor

        config CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT3X
          bool "AHT3X"
          help
            AHT3X humidity/temperature sensor

        config CHOICE_ENVIRONMENT_SENSOR_TYPE_BME280
          bool "BME280 [[DIM]]/ BMP180 / BMP280 / BMP388 / BME680[[/DIM]]"
          help
            BME280 humidity/temperature/pressure sensor. Klipper detects the
            chip, so this also covers BMP180, BMP280, BMP388 and BME680.
            Only BME280 and BME680 report humidity; with a BMP chip, drying
            runs for its full time and any humidity goal is ignored.

        config CHOICE_ENVIRONMENT_SENSOR_TYPE_HTU21D
          bool "HTU21D"
          help
            HTU21D humidity/temperature sensor

        config CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7013
          bool "SI7013 [[DIM]]/ HTU21D family[[/DIM]]"
          help
            SI7013 humidity/temperature sensor (Klipper's HTU21D driver)

        config CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7020
          bool "SI7020 [[DIM]]/ HTU21D family[[/DIM]]"
          help
            SI7020 humidity/temperature sensor (Klipper's HTU21D driver)

        config CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7021
          bool "SI7021 [[DIM]]/ HTU21D family[[/DIM]]"
          help
            SI7021 humidity/temperature sensor (Klipper's HTU21D driver)

        config CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT21
          bool "SHT21 [[DIM]]/ HTU21D family[[/DIM]]"
          help
            SHT21 humidity/temperature sensor (Klipper's HTU21D driver)

        config CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT3X
          bool "SHT3X"
          help
            SHT3X (SHT30/SHT31/SHT35) humidity/temperature sensor

        config CHOICE_ENVIRONMENT_SENSOR_TYPE_LM75
          bool "LM75 [[DIM]]/ temperature only[[/DIM]]"
          help
            LM75 temperature sensor. It has no humidity reading, so drying
            runs for its full time and any humidity goal is ignored.
      endchoice

      config PARAM_ENVIRONMENT_SENSOR_TYPE
        string
        default "AHT10"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT10
        default "AHT1X"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT1X
        default "AHT2X"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT2X
        default "AHT3X"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT3X
        default "BME280" if CHOICE_ENVIRONMENT_SENSOR_TYPE_BME280
        default "HTU21D" if CHOICE_ENVIRONMENT_SENSOR_TYPE_HTU21D
        default "SI7013" if CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7013
        default "SI7020" if CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7020
        default "SI7021" if CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7021
        default "SHT21"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT21
        default "SHT3X"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT3X
        default "LM75"   if CHOICE_ENVIRONMENT_SENSOR_TYPE_LM75

      config PARAM_SENSOR_REPORT_TIME_PARAM
        string
        default "aht10_report_time"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT10 || CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT1X || CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT2X || CHOICE_ENVIRONMENT_SENSOR_TYPE_AHT3X
        default "htu21d_report_time" if CHOICE_ENVIRONMENT_SENSOR_TYPE_HTU21D || CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7013 || CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7020 || CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7021 || CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT21
        default "sht3x_report_time"  if CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT3X
        default "lm75_report_time"   if CHOICE_ENVIRONMENT_SENSOR_TYPE_LM75
        default ""

      config PARAM_ENVIRONMENT_SENSOR_REPORT_TIME
        int "Report time (secs)" if PARAM_SENSOR_REPORT_TIME_PARAM != ""
        default 0  if CHOICE_ENVIRONMENT_SENSOR_TYPE_BME280
        default 60
        range 0 300     if CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT3X || CHOICE_ENVIRONMENT_SENSOR_TYPE_LM75
        range 0 0 5 300
        help
          Seconds between sensor readings (default 60 seconds)

          0 leaves the option out so Klipper uses its own default
          (30 secs; 1 sec for SHT3X, 0.8 secs for LM75).
          Otherwise at least 5 secs (1 sec for SHT3X and LM75).

      config PARAM_ENVIRONMENT_SENSOR_I2C_ADDRESS
        int "i2c address       "
        default 118 if CHOICE_ENVIRONMENT_SENSOR_TYPE_BME280
        default 64  if CHOICE_ENVIRONMENT_SENSOR_TYPE_HTU21D || CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7013 || CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7020 || CHOICE_ENVIRONMENT_SENSOR_TYPE_SI7021 || CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT21
        default 68  if CHOICE_ENVIRONMENT_SENSOR_TYPE_SHT3X
        default 72  if CHOICE_ENVIRONMENT_SENSOR_TYPE_LM75
        default 56
        help
          i2c address of the environment sensor (default 56 [0x38] for AHT sensors, 118 [0x76] for BME280, 64 [0x40] for HTU21D family, 68 [0x44] for SHT3X, 72 [0x48] for LM75)
          BMP180, BMP388 and some BME280 sensors use 119 [0x77] instead of 118.

      if CHOICE_ENVIRONMENT_SENSOR_I2C_HARDWARE
        choice CHOICE_ENVIRONMENT_SENSOR_I2C_BUS
          prompt "i2c bus name      "
          default CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_I2C3 if BOARD_TYPE_EBB_GEN1
          default CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_I2C2
          help
            Select the hardware i2c bus to use for the environment sensor

        config CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_I2C2
            bool "i2c2_PB10_PB11"
            help
              Hardware i2c bus i2c2 with SCL on PB10 and SDA on PB11

        config CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_I2C3
            bool "i2c3_PB3_PB4"
            help
              Hardware i2c bus i2c3 with SCL on PB3 and SDA on PB4
        endchoice

        config PARAM_ENVIRONMENT_SENSOR_I2C_BUS
            string
            default "i2c2_PB10_PB11" if CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_I2C2
            default "i2c3_PB3_PB4"   if CHOICE_ENVIRONMENT_SENSOR_I2C_BUS_I2C3
      endif

      if CHOICE_ENVIRONMENT_SENSOR_I2C_SOFTWARE
        config PIN_ENVIRONMENT_SENSOR_SCL
          string "SCL pin           "
          validator "$(pin_validator)"
          default ""
          help
            Software i2c SCL pin (e.g., "PB10")

        config PIN_ENVIRONMENT_SENSOR_SDA
          string "SDA pin           "
          validator "$(pin_validator)"
          default ""
          help
            Software i2c SDA pin (e.g., "PB11")
      endif
  endmenu
endif


# -------------------------------------
# MCU CPU Temperature sensors
# -------------------------------------

config BOOL_CREATE_MCU_ENVIRONMENT_SENSORS
  bool "Create MCU CPU sensor(s)?"
  depends on !BOARD_TYPE_MANUAL
  default y
  help
    Create [temperature_sensor] sections for the MCU(s) themselves for CPU temperature monitoring.

if BOOL_CREATE_MCU_ENVIRONMENT_SENSORS
  config BOOL_HIDE_MCU_ENVIRONMENT_SENSORS
    bool "Hide in Mainsail / Fluidd"
    default y if MMU_HAS_ENVIRONMENT_SENSOR
    default n
    help
      Hide MCU temperature sensor(s) in Mainsail / Fluidd interface.
endif
