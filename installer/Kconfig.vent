# Responsible for setting:
#   MMU_HAS_VENT_SERVO
#
# Vent servo parameter tokens which must be inside if MMU_HAS_VENT_SERVO clause in cfg templates:
#   PIN_VENT_SERVO (shared configuration)
#   PARAM_VENT_SERVO_GATE_X, PIN_VENT_SERVO_X (per-gate configuration, Kconfig.per_gate)
#   PARAM_VENT_SERVO_MIN_PULSE_WIDTH
#   PARAM_VENT_SERVO_MAX_PULSE_WIDTH
#   PARAM_VENT_SERVO_MAXIMUM_ANGLE
#
# Can be disabled and forced off with:
#   select UNSELECT_MMU_HAS_VENT_SERVO


comment "_"
comment "_Enclosure Vent"

config UNSELECT_MMU_HAS_VENT_SERVO
  def_bool n

if !UNSELECT_MMU_HAS_VENT_SERVO
  config MMU_HAS_VENT_SERVO
    prompt "Has enclosure vent servo?"
    forceshow
    default n
    help
      Select if a servo opens and closes a vent in the filament enclosure.
      Happy Hare opens it every heater_vent_interval minutes while drying and
      closes it again after the vent open time. The angles and timings are
      set with the other venting options under the heater settings. With
      per-gate configuration each gate can have its own vent servo.
endif


# -------------------------------------
# Vent servo config
# -------------------------------------

if MMU_HAS_VENT_SERVO
  menu "Vent servo h/w config"
    help
      Configure the pin and PWM range of the enclosure vent servo. The PWM
      range applies to every vent servo of this unit.

    config PIN_VENT_SERVO
      string
      prompt "Vent servo pin       " if !MMU_HAS_PER_GATE_CONFIG
      validator "$(pin_validator)"
      default ""
      help
        $(pin_help)

    config PARAM_VENT_SERVO_MIN_PULSE_WIDTH
      float "Servo min pulse width"
      default 0.001

    config PARAM_VENT_SERVO_MAX_PULSE_WIDTH
      float "Servo max pulse width"
      default 0.002

    config PARAM_VENT_SERVO_MAXIMUM_ANGLE
      int "Servo h/w max angle  "
      range 0 360
      default 180
      help
        Klipper scales the PWM pulse width to never exceed this angle

  endmenu
endif
