# Speed settings for gear stepper, selector stepper and extruder movement
#
# Responsible for setting:
#   PARAM_GEAR_LOAD_SPEED
#   PARAM_GEAR_LOAD_ACCEL
#   PARAM_GEAR_FROM_FILAMENT_BUFFER_SPEED
#   PARAM_GEAR_FROM_FILAMENT_BUFFER_ACCEL
#   PARAM_GEAR_UNLOAD_SPEED
#   PARAM_GEAR_UNLOAD_ACCEL
#   PARAM_GEAR_HOMING_SPEED
#   PARAM_GEAR_SHORT_MOVE_SPEED
#   PARAM_GEAR_SHORT_MOVE_ACCEL
#   PARAM_GEAR_SHORT_MOVE_THRESHOLD
#
# These must be in a "if MMU_HAS_SELECTOR_STEPPER" clause in cfg templates
#   PARAM_SELECTOR_MOVE_SPEED
#   PARAM_SELECTOR_HOMING_SPEED
#   PARAM_SELECTOR_TOUCH_SPEED
#   PARAM_SELECTOR_ACCEL
#
# These are shared by all mmu_units
#   PARAM_EXTRUDER_LOAD_SPEED
#   PARAM_EXTRUDER_UNLOAD_SPEED
#   PARAM_EXTRUDER_SYNC_LOAD_SPEED
#   PARAM_EXTRUDER_SYNC_UNLOAD_SPEED
#   PARAM_EXTRUDER_HOMING_SPEED
#   PARAM_EXTRUDER_ACCEL

menu "Speeds"

# -------------------------------------
# Gear
# -------------------------------------

  if !MULTI_UNIT_ENTRY_POINT

    comment "_Bowden movement speeds (mm/s)"

    config PARAM_GEAR_LOAD_SPEED
      float "Normal bowden load speed        "
      default 100
      help
        This is the default bowden load speed for long movements.
        On systems with a buffer that catches loose filament this can be used to
        set a lower speed (for first time load) to overcome friction without
        the stepper loosing steps

    config PARAM_GEAR_LOAD_ACCEL
      float "Normal load acceleration        "
      default 100
      help
        Default bowden load acceleration for long movements.

    if MMU_HAS_FILAMENT_BUFFER
      config PARAM_GEAR_FROM_FILAMENT_BUFFER_SPEED
        float "From filament buffer load speed "
        default 150
        help
          High speed for normal filament loading (or from filament buffer if fitted)

      config PARAM_GEAR_FROM_FILAMENT_BUFFER_ACCEL
        float "From buffer load acceleration   "
        default 400
    endif

    config PARAM_GEAR_UNLOAD_SPEED
      float "Normal bowden unload speed      "
      default 80
      help
        You can use a lower speed when unloading filament. This is useful if you have an eSpool
        rewinder system that limits speed

    config PARAM_GEAR_UNLOAD_ACCEL
      float "Normal unload acceleration      "
      default 100

    config PARAM_GEAR_HOMING_SPEED
      float "Gear homing speed               "
      default 50
      help
        Speed of gear stepper only homing moves (e.g. homing to gate or extruder)

    config PARAM_GEAR_SHORT_MOVE_SPEED
      float "Short movement speed            "
      default 80
      help
        Speed when making short moves (e.g. incremental retracts with encoder)

    config PARAM_GEAR_SHORT_MOVE_ACCEL
      float "Short movement acceleration     "
      default 400

    config PARAM_GEAR_SHORT_MOVE_THRESHOLD
      float "Short move threshold            "
      default 70
      help
        Individual move distance below which is considered a short move

    config PARAM_VIRTUAL_SENSOR_HOMING_SPEED
      float "Virtual sensor homing speed     "
      default 15
      help
        Special slow speed used for homing to virtual endstops (like
        filament_compression and filament_tension with a proportional
        sync-feedback buffer, or using Qidi filament width sensor
        as a substitute for extruder or toolhead sensor.
        This applies to all steppers using virtual endstops.

    comment "_"
  endif


# -------------------------------------
# Extruder
# -------------------------------------

  if !MULTI_UNIT || MULTI_UNIT_ENTRY_POINT

    comment "_Extruder movement speeds (mm/s)"

    config PARAM_EXTRUDER_LOAD_SPEED
      float "Extruder load speed             "
      default 16
      help
        Speed of load move inside extruder from homing position to meltzone

    config PARAM_EXTRUDER_UNLOAD_SPEED
      float "Extruder unload speed           "
      default 16
      help
        Speed of unload moves inside of extruder
        (very initial move from meltzone is 50% of this)

    config PARAM_EXTRUDER_SYNC_LOAD_SPEED
      float "Extruder sync load speed        "
      default 18
      help
        Speed of load move inside extruder from homing position to meltzone
        when synced with MMU gear stepper

    config PARAM_EXTRUDER_SYNC_UNLOAD_SPEED
      float "Extruder sync unload speed      "
      default 18
      help
        Speed of unload moves inside of extruder when synced with MMU gear stepper
        (very initial move from meltzone is 50% of this)

    config PARAM_EXTRUDER_HOMING_SPEED
      float "Extruder homing speed           "
      default 16
      help
        Speed of extruder only homing moves (e.g. to toolhead sensor)

    config PARAM_EXTRUDER_ACCEL
      float "Extruder acceleration           "
      default 1500
      help
        The acceleration of the extruder stepper is limited to this value when performing MMU
        filament load/unload moves. This prevents too rapid a movement that could cause the
        extruder stepper to loose steps

  endif


# -------------------------------------
# Selector
# -------------------------------------

  if !MULTI_UNIT_ENTRY_POINT && MMU_HAS_SELECTOR_STEPPER

    comment "_"
    comment "_Selector movement speeds (mm/s)"

    config PARAM_SELECTOR_MOVE_SPEED
      float "Speed of selector movement      "
      default 200

    config PARAM_SELECTOR_HOMING_SPEED
      float "Speed of selector homing moves  "
      depends on LINEAR_SELECTOR || LINEAR_SERVO_SELECTOR || LINEAR_MULTI_GEAR_SELECTOR || ROTARY_SELECTOR || TESTING_SELECTOR
      default 60

    config PARAM_SELECTOR_TOUCH_SPEED
      float "Speed of touch selector movement"
      depends on LINEAR_SELECTOR || LINEAR_SERVO_SELECTOR || LINEAR_MULTI_GEAR_SELECTOR || TESTING_SELECTOR
      default 80

    config PARAM_SELECTOR_ACCEL
      float "Selector stepper acceleration   "
      default 1200

  endif 

endmenu
