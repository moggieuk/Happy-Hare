# Defines parameter token types and defaults for purging
#
# Feature flags and derived bus settings:
#   MMU_HAS_BLOBIFIER
#   MMU_HAS_BLOBIFIER_BUCKET_SWITCH
#   BOOL_BLOBIFIER_TMC_CAN_UART
#   BOOL_BLOBIFIER_TMC_CAN_SPI
#   BOOL_BLOBIFIER_TMC_SPI
#   BOOL_BLOBIFIER_TMC_HAS_HOLD_CURRENT
#   BOOL_BLOBIFIER_TMC_HAS_STEALTHCHOP
#   BOOL_BLOBIFIER_TMC_HAS_RREF
#   BOOL_BLOBIFIER_TMC_SPI_SOFTWARE
#
# Blobifier bucket switch:
#   PIN_BLOBIFIER_BUCKET_SWITCH
#
# Blobifier servo tray:
#   PIN_BLOBIFIER_SERVO
#   PARAM_BLOBIFIER_MINIMUM_PULSE_WIDTH
#   PARAM_BLOBIFIER_MAXIMUM_PULSE_WIDTH
#
# Blobifier stepper tray: (only used when CHOICE_BLOBIFIER_TYPE_STEPPER)
#   PIN_BLOBIFIER_STEP
#   PIN_BLOBIFIER_DIR
#   PIN_BLOBIFIER_ENABLE
#   PIN_BLOBIFIER_ENDSTOP
#   PARAM_BLOBIFIER_TMC
#   PIN_BLOBIFIER_UART
#   PIN_BLOBIFIER_CS
#   PIN_BLOBIFIER_SPI_SCLK
#   PIN_BLOBIFIER_SPI_MOSI
#   PIN_BLOBIFIER_SPI_MISO
#   PARAM_BLOBIFIER_SPI_BUS
#   PARAM_BLOBIFIER_RUN_CURRENT
#   PARAM_BLOBIFIER_HOLD_CURRENT
#   PARAM_BLOBIFIER_SENSE_RESISTOR
#   PARAM_BLOBIFIER_RREF
#
# Purge macro and behavior:
#   PARAM_PURGE_MACRO
#   PARAM_FORCE_PURGE_STANDALONE
#   PARAM_EXTRUDER_PURGE_CURRENT

config MMU_HAS_BLOBIFIER
  def_bool n

config PIN_BLOBIFIER_SERVO
  string
  default ""

config PIN_BLOBIFIER_BUCKET_SWITCH
  string
  default ""

config MMU_HAS_BLOBIFIER_BUCKET_SWITCH
  bool
  default y

config PIN_BLOBIFIER_STEP
  string
  default ""

config PIN_BLOBIFIER_DIR
  string
  default ""

config PIN_BLOBIFIER_ENABLE
  string
  default ""

config PIN_BLOBIFIER_ENDSTOP
  string
  default ""

config PIN_BLOBIFIER_UART
  string
  default ""

config PIN_BLOBIFIER_CS
  string
  default ""

config PIN_BLOBIFIER_SPI_SCLK
  string
  default ""

config PIN_BLOBIFIER_SPI_MOSI
  string
  default ""

config PIN_BLOBIFIER_SPI_MISO
  string
  default ""

config PARAM_BLOBIFIER_SPI_BUS
  string
  default ""

config PARAM_BLOBIFIER_RUN_CURRENT
  float
  default 0.6

config PARAM_BLOBIFIER_HOLD_CURRENT
  float
  default 0.1

# TMC2226 ships a 0.150 shunt, TMC5160 a 0.075 one; the rest use 0.110.
# TMC2240 has no shunt at all - it sizes current from rref instead.
config PARAM_BLOBIFIER_SENSE_RESISTOR
  float
  default 0.150 if CHOICE_BLOBIFIER_TMC2226
  default 0.075 if CHOICE_BLOBIFIER_TMC5160
  default 0.110

config PARAM_BLOBIFIER_RREF
  int
  default 12000

# Klipper module implementing each chip. TMC2226 is register-compatible
# with the TMC2209 and has no module of its own.
config PARAM_BLOBIFIER_TMC
  string
  default "tmc2209" if CHOICE_BLOBIFIER_TMC2209
  default "tmc2209" if CHOICE_BLOBIFIER_TMC2226
  default "tmc2208" if CHOICE_BLOBIFIER_TMC2208
  default "tmc2130" if CHOICE_BLOBIFIER_TMC2130
  default "tmc2660" if CHOICE_BLOBIFIER_TMC2660
  default "tmc5160" if CHOICE_BLOBIFIER_TMC5160
  default "tmc2240" if CHOICE_BLOBIFIER_TMC2240
  default ""

# Which buses the chosen chip can actually speak. Only the TMC2240 does
# both, so only it gets a bus prompt; the rest are fixed by the silicon.
config BOOL_BLOBIFIER_TMC_CAN_UART
  bool
  default y if CHOICE_BLOBIFIER_TMC2209 || CHOICE_BLOBIFIER_TMC2226 || \
      CHOICE_BLOBIFIER_TMC2208 || CHOICE_BLOBIFIER_TMC2240

config BOOL_BLOBIFIER_TMC_CAN_SPI
  bool
  default y if CHOICE_BLOBIFIER_TMC2130 || CHOICE_BLOBIFIER_TMC2660 || \
      CHOICE_BLOBIFIER_TMC5160 || CHOICE_BLOBIFIER_TMC2240

config BOOL_BLOBIFIER_TMC_SPI
  bool
  default y if CHOICE_BLOBIFIER_TMC_BUS_SPI

# Two flags, not one: the TMC2660 happens to lack both, but hold_current
# and stealthchop are separate Klipper options that other chips may drop
# independently. It idles via idle_current_percent, whose Klipper default
# of 100 is what we want, so nothing replaces hold_current for it.
config BOOL_BLOBIFIER_TMC_HAS_HOLD_CURRENT
  bool
  default y if PARAM_BLOBIFIER_TMC != "" && !CHOICE_BLOBIFIER_TMC2660

config BOOL_BLOBIFIER_TMC_HAS_STEALTHCHOP
  bool
  default y if PARAM_BLOBIFIER_TMC != "" && !CHOICE_BLOBIFIER_TMC2660

config BOOL_BLOBIFIER_TMC_HAS_RREF
  bool
  default y if CHOICE_BLOBIFIER_TMC2240

# Any supplied pin means software SPI, even when the trio is incomplete.
# SW6 warns about missing pins; never silently switch to a different bus.
config BOOL_BLOBIFIER_TMC_SPI_SOFTWARE
  bool
  default y if BOOL_BLOBIFIER_TMC_SPI && \
      (PIN_BLOBIFIER_SPI_SCLK != "" || \
       PIN_BLOBIFIER_SPI_MOSI != "" || \
       PIN_BLOBIFIER_SPI_MISO != "")


# -------------------------------------
# Purging menu
# -------------------------------------

menu "Purging"
  help
    Purging

  # -------------------------------------
  # Blobifier configuration
  # -------------------------------------

  config MMU_HAS_BLOBIFIER
    prompt "Have Blobifier?"
    help
      Enable this if you have a Blobifier purging system fitted.

      NOTE: There is a lot of setup for Blobifier. After enabling this
      be sure to edit Macro variables

  if MMU_HAS_BLOBIFIER
    config MMU_HAS_BLOBIFIER_BUCKET_SWITCH
      prompt "Have Blobifier bucket switch?"
      help
        Enable this only if a switch detects whether the Blobifier collection
        bucket is installed. Blobifier itself does not require a bucket switch.

    if MMU_HAS_BLOBIFIER_BUCKET_SWITCH
      config PIN_BLOBIFIER_BUCKET_SWITCH
        prompt "Blobifier bucket switch pin"
        help
          The pull-up ( ^ ) is important here. For example: ^mcu:PA1
    endif

    choice CHOICE_BLOBIFIER_TYPE
      prompt "Blobifier tray actuator    "
      default CHOICE_BLOBIFIER_TYPE_SERVO
      help
        How the Blobifier tray is actuated: a servo (default) or a manual_stepper.

      config CHOICE_BLOBIFIER_TYPE_SERVO
        bool "Servo"
      config CHOICE_BLOBIFIER_TYPE_STEPPER
        bool "Stepper"
    endchoice

    if CHOICE_BLOBIFIER_TYPE_SERVO
      config PIN_BLOBIFIER_SERVO
        prompt "Blobifier servo pin        "

      config PARAM_BLOBIFIER_MINIMUM_PULSE_WIDTH
        float "Servo min pulse width      "
        default 0.00053
        help
          Adjust until a 'BLOBIFIER_SERVO POS=out' extends the tray fully without a buzzing sound

          The default value is likely to be close so don't worry about this for now

      config PARAM_BLOBIFIER_MAXIMUM_PULSE_WIDTH
        float "Servo max pulse width      "
        default 0.0023
        help
          Adjust until a 'BLOBIFIER_SERVO POS=in' retracts the tray fully without a buzzing sound

          The default value is likely to be close so don't worry about this for now
    endif

    if CHOICE_BLOBIFIER_TYPE_STEPPER
      config PIN_BLOBIFIER_STEP
        prompt "Stepper step pin           "
      config PIN_BLOBIFIER_DIR
        prompt "Stepper dir pin            "
      config PIN_BLOBIFIER_ENABLE
        prompt "Stepper enable pin         "
      config PIN_BLOBIFIER_ENDSTOP
        prompt "Stepper endstop pin        "
        help
          The pull-up/invert ( ^! ) is typically required here
      choice CHOICE_BLOBIFIER_TMC
        prompt "Stepper TMC chip           "
        default CHOICE_BLOBIFIER_TMC2209
        help
          Select correct TMC chip type for the Blobifier tray stepper.
          The bus (UART or SPI) is fixed by the chip, except on the
          TMC2240 which can do either.

        config CHOICE_BLOBIFIER_TMC2209
          bool "TMC2209"
        config CHOICE_BLOBIFIER_TMC2226
          bool "TMC2226"
        config CHOICE_BLOBIFIER_TMC2208
          bool "TMC2208"
        config CHOICE_BLOBIFIER_TMC2130
          bool "TMC2130"
        config CHOICE_BLOBIFIER_TMC2660
          bool "TMC2660"
        config CHOICE_BLOBIFIER_TMC5160
          bool "TMC5160"
        config CHOICE_BLOBIFIER_TMC2240
          bool "TMC2240"
        config CHOICE_BLOBIFIER_TMC_NONE
          bool "None / hardware controlled"
      endchoice

      choice CHOICE_BLOBIFIER_TMC_BUS
        prompt "Stepper TMC bus            " if PARAM_BLOBIFIER_TMC != ""
        default CHOICE_BLOBIFIER_TMC_BUS_SPI
        help
          Only the TMC2240 offers a choice here. Most TMC2240 step sticks
          ship wired for SPI and need a jumper or solder bridge moved to
          use UART, so SPI is the default.

        config CHOICE_BLOBIFIER_TMC_BUS_UART
          bool "UART"
          depends on BOOL_BLOBIFIER_TMC_CAN_UART
        config CHOICE_BLOBIFIER_TMC_BUS_SPI
          bool "SPI"
          depends on BOOL_BLOBIFIER_TMC_CAN_SPI
      endchoice

      config PIN_BLOBIFIER_UART
        prompt "Stepper TMC UART pin       " if PARAM_BLOBIFIER_TMC != "" && !BOOL_BLOBIFIER_TMC_SPI
      config PIN_BLOBIFIER_CS
        prompt "Stepper TMC CS pin         " if BOOL_BLOBIFIER_TMC_SPI
      config PARAM_BLOBIFIER_SPI_BUS
        prompt "Stepper TMC SPI bus        " if BOOL_BLOBIFIER_TMC_SPI && !BOOL_BLOBIFIER_TMC_SPI_SOFTWARE
        help
          Hardware SPI bus name on the MCU owning the CS pin, e.g. spi2.
          Leave blank to use Klipper's default bus for that MCU.
      config PIN_BLOBIFIER_SPI_SCLK
        prompt "Stepper TMC SPI SCLK pin   " if BOOL_BLOBIFIER_TMC_SPI
        help
          Leave all three SPI pins blank to use hardware SPI. To use software
          SPI, fill in all three pins. An incomplete set is an error.
          Prefix each pin with its MCU name; all three must be on the same
          MCU as the CS pin, e.g. mcu:PG8.
      config PIN_BLOBIFIER_SPI_MOSI
        prompt "Stepper TMC SPI MOSI pin   " if BOOL_BLOBIFIER_TMC_SPI
      config PIN_BLOBIFIER_SPI_MISO
        prompt "Stepper TMC SPI MISO pin   " if BOOL_BLOBIFIER_TMC_SPI

      config PARAM_BLOBIFIER_RUN_CURRENT
        prompt "Stepper run current        " if PARAM_BLOBIFIER_TMC != ""
      config PARAM_BLOBIFIER_HOLD_CURRENT
        prompt "Stepper hold current       " if BOOL_BLOBIFIER_TMC_HAS_HOLD_CURRENT
      config PARAM_BLOBIFIER_SENSE_RESISTOR
        prompt "Stepper sense resistor     " if PARAM_BLOBIFIER_TMC != "" && !BOOL_BLOBIFIER_TMC_HAS_RREF
      config PARAM_BLOBIFIER_RREF
        prompt "Stepper rref (ohms)        " if BOOL_BLOBIFIER_TMC_HAS_RREF
        range 12000 60000
        help
          TMC2240 sets its current range from an external reference
          resistor rather than a shunt. 12000 is the value fitted to
          almost every step stick; change it only if yours differs.
    endif
  endif


  # -------------------------------------
  # Standalone purge choice
  # -------------------------------------

  comment "_"
  comment "_Essential purge configuration"

  choice CHOICE_PURGE_MACRO
    prompt "Select standalone purging option"
    default CHOICE_PURGE_MACRO_BLOBIFIER if MMU_HAS_BLOBIFIER
    default CHOICE_PURGE_MACRO_PURGE
    help
      How to perform standalone purging operation.

    config CHOICE_PURGE_MACRO_PURGE
      bool "Simple purge into bucket"
      help
        This simple built in macro simply purges the required volume of
        filament.  Position can be controlled so this is done into a
        purge bucket.

    if MMU_HAS_BLOBIFIER
      config CHOICE_PURGE_MACRO_BLOBIFIER
        bool "Blobifier"
        help
          This popular choice purges into "poop" sized pellets which
          are optionally caught by a collection bucket.
    endif

    config CHOICE_PURGE_MACRO_SLICER
      bool "Slicer managed"
      help
        Purging is controlled and managed by the slicer rather than Happy-Hare.

    config CHOICE_PURGE_MACRO_OTHER
      bool "Other / manually entered"
      help
        Specify a custom macro to call to perform purging

    config PURGE_MACRO_OTHER
      string "Purging macro" if CHOICE_PURGE_MACRO_OTHER
      default "-enter-your-macro-"
      help
        Name of macro to call to perform the standalone purging operation.
  endchoice

  config PARAM_PURGE_MACRO
    string
    default "_MMU_PURGE"      if CHOICE_PURGE_MACRO_PURGE
    default "BLOBIFIER"       if CHOICE_PURGE_MACRO_BLOBIFIER
    default ""                if CHOICE_PURGE_MACRO_SLICER
    default PURGE_MACRO_OTHER if CHOICE_PURGE_MACRO_OTHER
    default ""


  # -------------------------------------
  # Other purge options
  # -------------------------------------

  config PARAM_FORCE_PURGE_STANDALONE
    boolint "Happy Hare controlled in-print purge"
    default 0 if CHOICE_PURGE_MACRO_SLICER
    default 1
    help
      You can choose whether you want the slicer or Happy Hare (recommended) to control filament purging.
      To use intelligent volume purging or purge systems like Blobifier ensure this selection is checked
      and be sure to TURN OFF in your slicer
  config PARAM_EXTRUDER_PURGE_CURRENT
    int "Extruder purging current       "
    default 100
    help
      % of extruder current (100%-150%) to use when purging (100 to disable feature)

endmenu
