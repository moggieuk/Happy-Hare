# Responsible for defining/setting managed fan configuration:
#   MMU_HAS_FANS
#   MMU_HAS_PER_GATE_FANS
#
# Fan parameter tokens
#   PARAM_FAN_MAX_POWER
#   PARAM_FAN_KICK_START_TIME
#   PIN_FAN   (single MCU)
#   PIN_FAN_X (per-gate MCU)
#
# Fan control parameter tokens
#   PARAM_DEFAULT_FAN_TEMPERATURE_SOURCE
#   PARAM_DEFAULT_FAN_ON_TEMP
#   PARAM_DEFAULT_FAN_OFF_TEMP
#   PARAM_FAN_POLLING_TIME
#   PARAM_FAN_CONTROL_ENABLED
#   PARAM_FAN_FORCED_MODE (choice: AUTO, OFF, ON)
#   PARAM_FAN_FORCED (mapped value: 0, 1, 2)
#
# Can be disabled and forced off with:
#   select UNSELECT_MMU_HAS_FANS


comment "_"
comment "_Fans"

config UNSELECT_MMU_HAS_FANS
  def_bool n

if !UNSELECT_MMU_HAS_FANS
  config MMU_HAS_FANS
    bool "Has managed fans?"
    forceshow
    default n
    help
      Enable this if you have fans installed in your MMU unit(s). Fans are
      created as [fan_generic] objects so Happy Hare can use them for automatic
      temperature control or direct MMU_FAN control.
endif


# -------------------------------------
# Fan hardware config
# -------------------------------------

if MMU_HAS_FANS
  menu "Fan h/w config"

    config MMU_HAS_PER_GATE_FANS
      bool "Per-gate fans?"
      depends on MMU_HAS_PER_GATE_MCU
      default y if MMU_HAS_PER_GATE_MCU
      help
        Select this when individual gates have their own fans. Leave this off
        for the normal case of one fan shared by the whole MMU unit, including
        designs that otherwise use per-gate MCUs.

    config PARAM_FAN_MAX_POWER
      float "Fan maximum power  "
      default 1.0
      range 0.1 1.0
      help
        Maximum power setting for the fan (0.1 to 1.0).
        1.0 = 100% power

    config PARAM_FAN_KICK_START_TIME
      float "Fan kick start time"
      default 0.5
      range 0 3.0
      help
        Time in seconds to run fan at full power before resetting to target speed.

    if !MMU_HAS_PER_GATE_FANS
      config PIN_FAN
        string "Fan pin            "
        default ""
        help
          Pin for the fan shared by this MMU unit.
          Leave blank if you don't have a fan installed.
          Empty pins will be ignored in the generated configuration.
    endif

    menu "Fan pins" 
      depends on MMU_HAS_PER_GATE_FANS

      @repeat var=i min=0 max=11@
        config PIN_FAN_$(i)
          string "Fan $(i) pin" if PARAM_NUM_GATES > $(i)
          help 
            Leave blank if this gate does not have a fan installed.
      @endrepeat@
    endmenu

  endmenu

  config FAN_HAS_ENVIRONMENT_TEMPERATURE
    def_bool y if MMU_HAS_ENVIRONMENT_SENSOR

  config FAN_HAS_MCU_TEMPERATURE
    def_bool y if BOOL_CREATE_MCU_ENVIRONMENT_SENSORS

  menu "Fan controls"

    choice CHOICE_DEFAULT_FAN_TEMPERATURE_SOURCE
      prompt "Default fan temperature source"
      depends on FAN_HAS_ENVIRONMENT_TEMPERATURE || FAN_HAS_MCU_TEMPERATURE
      default CHOICE_DEFAULT_FAN_TEMPERATURE_SOURCE_ENVIRONMENT if FAN_HAS_ENVIRONMENT_TEMPERATURE
      default CHOICE_DEFAULT_FAN_TEMPERATURE_SOURCE_MCU if FAN_HAS_MCU_TEMPERATURE
      help
        Default source for every fan in the unit. Per-gate fans can be changed
        at runtime with MMU_FAN SOURCE= and GATE= or GATES=.

      config CHOICE_DEFAULT_FAN_TEMPERATURE_SOURCE_ENVIRONMENT
        bool "Environment sensor"
        depends on FAN_HAS_ENVIRONMENT_TEMPERATURE

      config CHOICE_DEFAULT_FAN_TEMPERATURE_SOURCE_MCU
        bool "MCU temperature"
        depends on FAN_HAS_MCU_TEMPERATURE

    endchoice

    config PARAM_DEFAULT_FAN_TEMPERATURE_SOURCE
      string
      default "environment" if CHOICE_DEFAULT_FAN_TEMPERATURE_SOURCE_ENVIRONMENT
      default "mcu" if CHOICE_DEFAULT_FAN_TEMPERATURE_SOURCE_MCU
      default ""

    config PARAM_DEFAULT_FAN_ON_TEMP
      float "Default fan ON temperature    "
      default 49.0
      range 20.0 80.0
      help
        Default temperature threshold (°C) to turn fans on. Per-gate ranges
        can be adjusted at runtime with MMU_FAN.

    config PARAM_DEFAULT_FAN_OFF_TEMP
      float "Default fan OFF temperature   "
      default 47.0
      range 20.0 80.0
      help
        Default temperature threshold (°C) to turn fans off. Per-gate ranges
        can be adjusted at runtime with MMU_FAN.

    config PARAM_FAN_POLLING_TIME
      float "Fan polling time              "
      default 5.0
      range 1.0 30.0
      help
        Time in seconds between temperature sensor polling intervals.

    config PARAM_FAN_CONTROL_ENABLED
      boolint "Enable fan temperature control"
      default y
      help
        Enable automatic fan control based on each fan's selected temperature
        source. Fans without a corresponding source remain off in AUTO mode but
        can still be controlled with MMU_FAN.

    choice PARAM_FAN_FORCED_MODE
      prompt "Default fan mode              "
      default PARAM_FAN_FORCED_MODE_AUTO

      config PARAM_FAN_FORCED_MODE_AUTO
        bool "AUTO"
        help
          Automatic fan control based on the selected temperature source.

      config PARAM_FAN_FORCED_MODE_OFF
        bool "All OFF"
        help
          Start all fans forced off.

      config PARAM_FAN_FORCED_MODE_ON
        bool "All ON"
        help
          Start all fans forced on.

    endchoice

    config PARAM_FAN_FORCED
      int
      default 0 if PARAM_FAN_FORCED_MODE_OFF
      default 1 if PARAM_FAN_FORCED_MODE_ON
      default 2 if PARAM_FAN_FORCED_MODE_AUTO

  endmenu
endif
