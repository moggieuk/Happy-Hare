+# Dummy GPIO configured as the firmware-side dir pin when the real dir pin is
+# virtual (e.g. a shift register bit driven from Python). Must be a pin that
+# nothing else uses on the stepper's mcu. 'PD5' is free on the Prusa MMU3
+# board (ATmega32U4).
+VIRTUAL_DIR_PLACEHOLDER_PIN = 'PD5'
+
 # Interface to low-level mcu and chelper code
 class MCU_stepper:
     def __init__(self, config, step_pin_params, dir_pin_params,
@@ -36,10 +42,25 @@
         self._invert_step = step_pin_params['invert']
         printer = mcu.get_printer()
         if dir_pin_params['chip'] is not mcu:
-            raise printer.config_error(
