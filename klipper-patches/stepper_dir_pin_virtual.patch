diff --git a/klippy/stepper.py b/klippy/stepper.py
index 538a5e82..97c76aac 100644
--- a/klippy/stepper.py
+++ b/klippy/stepper.py
@@ -35,10 +35,21 @@ class MCU_stepper:
         self._step_pin = step_pin_params['pin']
         self._invert_step = step_pin_params['invert']
         printer = mcu.get_printer()
-        if dir_pin_params['chip'] is not mcu:
-            raise printer.config_error(
-                "Stepper dir pin must be on same mcu as step pin")
-        self._dir_pin = dir_pin_params['pin']
+        self._dir_pin_virtual = None
+        dir_chip = dir_pin_params['chip']
+        if dir_chip is not mcu:
+            # Allow virtual chips (e.g. shift register) backed by the same MCU.
+            # Actual direction is controlled via Python-level ShiftRegisterBit.
+            backing_mcu = getattr(dir_chip, 'mcu', None)
+            if backing_mcu is not mcu:
+                raise printer.config_error(
+                    "Stepper dir pin must be on same mcu as step pin")
+            # Create virtual pin object for Python-level direction control
+            self._dir_pin_virtual = dir_chip.setup_pin('digital_out', dir_pin_params)
+            # Use SR DATA pin as harmless placeholder for MCU config_stepper
+            self._dir_pin = getattr(dir_chip, "_data_pin_name", "none")
+        else:
+            self._dir_pin = dir_pin_params["pin"]
         self._invert_dir = self._orig_invert_dir = dir_pin_params['invert']
         self._step_both_edge = self._req_step_both_edge = False
         self._mcu_position_offset = 0.
