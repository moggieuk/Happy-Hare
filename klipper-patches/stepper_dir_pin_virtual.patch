-        self._dir_pin = dir_pin_params['pin']
-        self._invert_dir = self._orig_invert_dir = dir_pin_params['invert']
+            # A dir pin on a virtual chip (e.g. a shift register bit) cannot be
+            # driven by the mcu firmware. Store the virtual pin object so
+            # callers (Happy Hare's MmuStepper._pre_set_dir_pin()) can write
+            # the direction from Python before each move, and give the firmware
+            # a dummy GPIO to configure as its dir pin -- it is never
+            # meaningfully driven. The virtual pin applies its own inversion,
+            # so the firmware-side dir inversion is disabled.
+            if not hasattr(dir_pin_params['chip'], 'setup_pin'):
+                raise printer.config_error(
+                    "Stepper dir pin chip '%s' is not on the stepper mcu '%s'"
+                    % (dir_pin_params['chip_name'], mcu.get_name()))
+            self._dir_pin_virtual = dir_pin_params['chip'].setup_pin(
+                'digital_out', dir_pin_params)
+            self._dir_pin = VIRTUAL_DIR_PLACEHOLDER_PIN
+            self._invert_dir = self._orig_invert_dir = 0
+        else:
+            self._dir_pin_virtual = None
+            self._dir_pin = dir_pin_params['pin']
+            self._invert_dir = self._orig_invert_dir = dir_pin_params['invert']
         self._step_both_edge = self._req_step_both_edge = False
         self._mcu_position_offset = 0.
         self._reset_cmd_tag = self._get_position_cmd = None
